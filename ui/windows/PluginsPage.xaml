<Page
    x:Class="Chuzi.Native.Windows.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="18" Padding="32,28,32,32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Spacing="4">
      <TextBlock Text="Plugins" FontSize="32" FontWeight="SemiBold" />
      <TextBlock Text="Review permissions and trust before enabling a plugin." Opacity="0.72" />
    </StackPanel>
    <InfoBar x:Name="CoreRequiredBar" Grid.Row="1" IsOpen="False" IsClosable="False" Severity="Informational" />
    <Grid Grid.Row="2">
      <ListView x:Name="PluginList" SelectionMode="None" IsItemClickEnabled="False">
      <ListView.ItemTemplate>
        <DataTemplate>
          <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,10">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Descriptor.ID}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Descriptor.Version}" Opacity="0.68" />
                <TextBlock Text="{Binding Descriptor.API}" Opacity="0.68" />
                <TextBlock Text="{Binding TrustSummary}" />
                <TextBlock Text="{Binding Descriptor.PermissionsSummary}" TextWrapping="Wrap" Opacity="0.68" />
                <TextBlock Text="{Binding Descriptor.CapabilitiesSummary}" TextWrapping="Wrap" Opacity="0.68" />
                <TextBlock Text="{Binding Health}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="8" MinWidth="150">
                <Button Content="Install" IsEnabled="{Binding Descriptor.Installable}" Tag="{Binding Descriptor.ID}" Click="InstallButton_Click" />
                <Button Content="Trust" IsEnabled="{Binding Installed}" Tag="{Binding Descriptor.ID}" Click="TrustButton_Click" />
                <Button Content="Untrust" IsEnabled="{Binding Trusted}" Tag="{Binding Descriptor.ID}" Click="UntrustButton_Click" />
                <Button Content="Enable" IsEnabled="{Binding Trusted}" Tag="{Binding Descriptor.ID}" Click="EnableButton_Click" />
                <Button Content="Disable" IsEnabled="{Binding Enabled}" Tag="{Binding Descriptor.ID}" Click="DisableButton_Click" />
                <Button Content="Remove" IsEnabled="{Binding Installed}" Tag="{Binding Descriptor.ID}" Click="RemoveButton_Click" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListView.ItemTemplate>
      </ListView>
      <TextBlock x:Name="EmptyText" Text="No plugins are included in this Core release." HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.72" />
    </Grid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10">
      <Button Content="Refresh" Click="RefreshButton_Click" />
      <ProgressRing x:Name="BusyRing" Width="22" Height="22" IsActive="False" />
    </StackPanel>
    <InfoBar x:Name="MessageBar" Grid.Row="3" IsOpen="False" IsClosable="True" HorizontalAlignment="Right" />
  </Grid>
</Page>
