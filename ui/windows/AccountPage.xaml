<Page
    x:Class="Chuzi.Native.Windows.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <Border Padding="32,28,32,32" MaxWidth="900">
      <StackPanel Spacing="22">
        <StackPanel Spacing="6">
          <TextBlock Text="Accounts" FontSize="32" FontWeight="SemiBold" />
          <TextBlock Text="Look up a redacted account state or submit a new task." Opacity="0.72" TextWrapping="Wrap" />
        </StackPanel>
        <InfoBar x:Name="CoreRequiredBar" IsOpen="False" IsClosable="False" Severity="Informational" />
        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
          <StackPanel Spacing="12">
            <TextBlock Text="Account ID" FontSize="20" FontWeight="SemiBold" />
            <TextBox x:Name="AccountIDBox" PlaceholderText="Enter an authorized account ID" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button x:Name="LookupButton" Content="Check status" Click="LookupButton_Click" />
              <Button x:Name="SubmitButton" Content="Submit task" Click="SubmitButton_Click" />
              <ProgressRing x:Name="BusyRing" Width="22" Height="22" IsActive="False" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
          <StackPanel Spacing="7">
            <TextBlock Text="Account status" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="AccountText" Text="No account loaded." />
            <TextBlock x:Name="StateText" Text="" Opacity="0.72" />
            <TextBlock x:Name="RequestText" Text="" Opacity="0.72" />
            <TextBlock x:Name="RevisionText" Text="" Opacity="0.72" />
          </StackPanel>
        </Border>
        <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True" />
      </StackPanel>
    </Border>
  </ScrollViewer>
</Page>
