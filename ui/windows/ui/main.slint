import { Button, CheckBox, ComboBox, GroupBox, LineEdit, Palette, ScrollView, SpinBox, VerticalBox, HorizontalBox } from "std-widgets.slint";
export { Palette } from "std-widgets.slint";

component PageHeader inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    height: 78px;
    background: transparent;

    VerticalBox {
        spacing: 5px;
        Text { text: root.title; color: Palette.foreground; font-size: 30px; font-weight: 700; vertical-stretch: 0; }
        Text { text: root.subtitle; color: Palette.alternate-foreground; wrap: word-wrap; vertical-stretch: 0; }
    }
}

component StatusBadge inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <color> accent: #2a9d67;
    height: 96px;
    background: Palette.alternate-background;
    border-color: Palette.border;
    border-width: 1px;
    border-radius: 8px;

    HorizontalBox {
        padding: 18px;
        spacing: 14px;
        Rectangle { width: 12px; height: 12px; background: root.accent; border-radius: 6px; }
        VerticalBox {
            spacing: 4px;
            Text { text: root.label; color: Palette.foreground; font-size: 19px; font-weight: 700; vertical-stretch: 0; }
            Text { text: root.detail; color: Palette.alternate-foreground; wrap: word-wrap; vertical-stretch: 0; }
        }
    }
}

component FeedbackBar inherits Rectangle {
    in property <string> text;
    in property <color> accent: #526c92;
    height: root.text == "" ? 0px : 44px;
    background: Palette.alternate-background;
    border-color: root.accent;
    border-width: 1px;
    border-radius: 6px;
    visible: root.text != "";
    Text { text: root.text; color: Palette.foreground; wrap: word-wrap; vertical-alignment: center; x: 14px; width: parent.width - 28px; }
}

export component MainWindow inherits Window {
    title: "Chuzi";
    min-width: 800px;
    min-height: 600px;
    preferred-width: 1120px;
    preferred-height: 760px;

    in-out property <string> page: "overview";
    in-out property <string> theme: "system";
    in-out property <string> core-status: "Checking Core";
    in-out property <string> core-details: "Checking the local Core service.";
    in-out property <string> data-directory: "";
    in-out property <string> message: "";
    in-out property <string> message-kind: "info";
    in-out property <bool> busy: false;
    in-out property <string> busy-operation: "";
    in-out property <bool> core-ready: false;
    in-out property <bool> core-installed: false;

    in-out property <string> account-input: "";
    in-out property <bool> account-loaded: false;
    in-out property <string> account-status: "No account loaded.";
    in-out property <string> account-state: "";
    in-out property <string> account-revision: "";
    in-out property <string> account-request: "";

    in-out property <string> request-input: "";
    in-out property <bool> task-loaded: false;
    in-out property <string> task-request-id: "";
    in-out property <string> task-status: "No request loaded.";
    in-out property <string> task-account: "";
    in-out property <string> task-state: "";
    in-out property <string> task-attempt: "";
    in-out property <string> task-failure: "";

    in-out property <image> browser-view;
    in-out property <bool> browser-view-loaded: false;
    in-out property <string> browser-view-status: "No browser view captured.";

    in-out property <string> plugin-input: "";
    in-out property <bool> plugin-loaded: false;
    in-out property <string> plugin-summary: "Core is not ready. Start Core to load plugins.";
    in-out property <string> plugin-id: "";
    in-out property <string> plugin-version: "";
    in-out property <string> plugin-health: "";
    in-out property <bool> plugin-installed: false;
    in-out property <bool> plugin-trusted: false;
    in-out property <bool> plugin-enabled: false;

    in-out property <string> component-input: "";
    in-out property <[string]> component-options: [];
    in-out property <bool> component-loaded: false;
    in-out property <string> component-summary: "Refresh to read the release manifest.";
    in-out property <string> component-id: "";
    in-out property <string> component-version: "";
    in-out property <string> component-health: "";
    in-out property <bool> component-installed: false;
    in-out property <bool> component-required: false;
    in-out property <bool> component-enabled: false;

    in-out property <bool> auto-check-updates: false;
    in-out property <bool> auto-repair: false;
    in-out property <string> update-channel: "nightly";
    in-out property <bool> launch-on-login: false;
    in-out property <bool> close-to-tray: false;
    in-out property <int> update-interval: 60;
    in-out property <string> rdp-host: "localhost";
    in-out property <string> rdp-port: "3389";
    in-out property <string> rdp-domain: "";
    in-out property <string> rdp-username: "";
    in-out property <string> rdp-password: "";
    in-out property <bool> rdp-allow-untrusted-certificate: false;
    in-out property <string> rdp-status: "No RDP session started.";

    callback install-core();
    callback start-core();
    callback stop-core();
    callback refresh-core();
    callback save-settings();
    callback theme-changed(string);
    callback refresh-plugins();
    callback install-plugin(string);
    callback trust-plugin(string);
    callback enable-plugin(string);
    callback remove-plugin(string);
    callback refresh-components();
    callback install-component(string);
    callback enable-component(string);
    callback disable-component(string);
    callback remove-component(string);
    callback lookup-account(string);
    callback submit-task(string);
    callback refresh-task(string);
    callback cancel-task(string);
    callback refresh-view(string);
    callback connect-rdp(string, string, string, string, string, bool);

    background: Palette.background;

    HorizontalBox {
        spacing: 0px;

        Rectangle {
            preferred-width: 224px;
            min-width: 196px;
            max-width: 250px;
            background: Palette.alternate-background;
            border-color: Palette.border;
            border-width: 1px;

            VerticalBox {
                padding-top: 22px;
                padding-bottom: 18px;
                padding-left: 14px;
                padding-right: 14px;
                spacing: 7px;
                Text { text: "Chuzi"; color: Palette.foreground; font-size: 24px; font-weight: 700; horizontal-alignment: center; vertical-stretch: 0; }
                Text { text: "CONTROL CENTER"; color: Palette.alternate-foreground; font-size: 11px; horizontal-alignment: center; vertical-stretch: 0; }
                Rectangle { height: 14px; background: transparent; vertical-stretch: 0; }

                HorizontalBox {
                    spacing: 4px;
                    Rectangle { width: 3px; background: root.page == "overview" ? #3d6f9f : transparent; border-radius: 2px; }
                    Button { text: "Overview"; clicked => { root.page = "overview"; } }
                }
                HorizontalBox {
                    spacing: 4px;
                    Rectangle { width: 3px; background: root.page == "plugins" ? #3d6f9f : transparent; border-radius: 2px; }
                    Button { text: "Plugins"; clicked => { root.page = "plugins"; } }
                }
                HorizontalBox {
                    spacing: 4px;
                    Rectangle { width: 3px; background: root.page == "accounts" ? #3d6f9f : transparent; border-radius: 2px; }
                    Button { text: "Accounts"; clicked => { root.page = "accounts"; } }
                }
                HorizontalBox {
                    spacing: 4px;
                    Rectangle { width: 3px; background: root.page == "tasks" ? #3d6f9f : transparent; border-radius: 2px; }
                    Button { text: "Tasks"; clicked => { root.page = "tasks"; } }
                }
                HorizontalBox {
                    spacing: 4px;
                    Rectangle { width: 3px; background: root.page == "rdp" ? #3d6f9f : transparent; border-radius: 2px; }
                    Button { text: "RDP"; clicked => { root.page = "rdp"; } }
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalBox {
                    spacing: 4px;
                    Rectangle { width: 3px; background: root.page == "settings" ? #3d6f9f : transparent; border-radius: 2px; }
                    Button { text: "Settings"; clicked => { root.page = "settings"; } }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: Palette.background;

            if root.page == "overview": ScrollView {
                VerticalBox {
                    padding: 32px;
                    spacing: 18px;
                    PageHeader { title: "Overview"; subtitle: "A clear view of Core readiness and the next action."; }
                    StatusBadge {
                        label: root.core-status;
                        detail: root.core-details;
                        accent: root.core-ready ? #2a9d67 : root.core-installed ? #c18a35 : #7a8490;
                        vertical-stretch: 0;
                    }
                    HorizontalBox {
                        spacing: 10px;
                        height: 40px;
                        vertical-stretch: 0;
                        Button { text: "Start Core"; enabled: root.core-installed && !root.core-ready && !root.busy; vertical-stretch: 0; clicked => { root.start-core(); } }
                        Button { text: "Stop Core"; enabled: root.core-ready && !root.busy; vertical-stretch: 0; clicked => { root.stop-core(); } }
                        Button { text: "Refresh"; enabled: !root.busy; vertical-stretch: 0; clicked => { root.refresh-core(); } }
                    }
                    FeedbackBar { text: root.message; accent: root.message-kind == "error" ? #b04a3a : root.message-kind == "success" ? #4b8c6a : #526c92; vertical-stretch: 0; }
                    GroupBox {
                        title: "First-run checklist";
                        max-height: 150px;
                        vertical-stretch: 0;
                        VerticalBox {
                            padding: 14px;
                            spacing: 9px;
                            Text { text: root.core-installed ? "1. Core is installed" : "1. Install Core from Settings > Components"; color: Palette.foreground; wrap: word-wrap; vertical-stretch: 0; }
                            Text { text: root.core-ready ? "2. Core is running" : "2. Start Core to unlock account and plugin actions"; color: Palette.alternate-foreground; wrap: word-wrap; vertical-stretch: 0; }
                            Text { text: "3. Review components and plugins, then personalize settings"; color: Palette.alternate-foreground; wrap: word-wrap; vertical-stretch: 0; }
                        }
                    }
                    GroupBox {
                        title: "Quick access";
                        max-height: 92px;
                        vertical-stretch: 0;
                        HorizontalBox {
                            padding: 14px;
                            spacing: 10px;
                            height: 40px;
                            Button { text: "Open Plugins"; clicked => { root.page = "plugins"; } }
                            Button { text: "Open Accounts"; clicked => { root.page = "accounts"; } }
                            Button { text: "Open Tasks"; clicked => { root.page = "tasks"; } }
                            Button { text: "Open Settings"; clicked => { root.page = "settings"; } }
                        }
                    }
                }
            }

            if root.page == "plugins": ScrollView {
                VerticalBox {
                    padding: 32px;
                    spacing: 18px;
                    PageHeader { title: "Plugins"; subtitle: "Review installation, signer trust, and enablement independently."; }
                    Text { text: root.plugin-summary; color: Palette.alternate-foreground; wrap: word-wrap; vertical-stretch: 0; }
                    if !root.core-ready: FeedbackBar { text: "Core is not running. Start Core before changing plugins."; accent: #c18a35; vertical-stretch: 0; }
                    GroupBox {
                        title: "Plugin actions";
                        max-height: 132px;
                        vertical-stretch: 0;
                        VerticalBox {
                            padding: 14px;
                            spacing: 10px;
                            LineEdit { placeholder-text: "Enter a plugin ID"; text <=> root.plugin-input; }
                            HorizontalBox {
                                spacing: 8px;
                                height: 40px;
                                vertical-stretch: 0;
                                Button { text: "Refresh"; enabled: root.core-ready && !root.busy; vertical-stretch: 0; clicked => { root.refresh-plugins(); } }
                                Button { text: "Install"; enabled: root.core-ready && !root.busy && root.plugin-input != ""; vertical-stretch: 0; clicked => { root.install-plugin(root.plugin-input); } }
                                Button { text: "Trust"; enabled: root.core-ready && !root.busy && root.plugin-input == root.plugin-id && root.plugin-installed && !root.plugin-trusted; vertical-stretch: 0; clicked => { root.trust-plugin(root.plugin-input); } }
                                Button { text: "Enable"; enabled: root.core-ready && !root.busy && root.plugin-input == root.plugin-id && root.plugin-installed && root.plugin-trusted && !root.plugin-enabled; vertical-stretch: 0; clicked => { root.enable-plugin(root.plugin-input); } }
                                Button { text: "Remove"; enabled: root.core-ready && !root.busy && root.plugin-input == root.plugin-id && root.plugin-installed; vertical-stretch: 0; clicked => { root.remove-plugin(root.plugin-input); } }
                            }
                        }
                    }
                    GroupBox {
                        title: "Current plugin";
                        max-height: 190px;
                        vertical-stretch: 0;
                        VerticalBox {
                            padding: 14px;
                            spacing: 7px;
                            Text { text: root.plugin-loaded ? root.plugin-id : "No plugin loaded."; font-size: 17px; font-weight: 700; vertical-stretch: 0; }
                            Text { text: root.plugin-loaded ? "Version: " + root.plugin-version : "Refresh to read the manifest."; color: Palette.alternate-foreground; vertical-stretch: 0; }
                            Text { text: root.plugin-loaded ? "Installed: " + (root.plugin-installed ? "Yes" : "No") : ""; color: Palette.alternate-foreground; vertical-stretch: 0; }
                            Text { text: root.plugin-loaded ? "Trusted: " + (root.plugin-trusted ? "Yes" : "No") : ""; color: Palette.alternate-foreground; vertical-stretch: 0; }
                            Text { text: root.plugin-loaded ? "Enabled: " + (root.plugin-trusted && root.plugin-enabled ? "Yes" : "No") : ""; color: Palette.alternate-foreground; vertical-stretch: 0; }
                            Text { text: root.plugin-loaded ? "Health: " + root.plugin-health : ""; color: Palette.alternate-foreground; vertical-stretch: 0; }
                        }
                    }
                    FeedbackBar { text: root.message; accent: root.message-kind == "error" ? #b04a3a : #526c92; vertical-stretch: 0; }
                }
            }

            if root.page == "accounts": ScrollView {
                VerticalBox {
                    padding: 32px;
                    spacing: 18px;
                    PageHeader { title: "Accounts"; subtitle: "Look up a redacted account projection or submit a request."; }
                    if !root.core-ready: FeedbackBar { text: "Core is not running. Start Core before looking up an account."; accent: #c18a35; vertical-stretch: 0; }
                    GroupBox {
                        title: "Account ID";
                        max-height: 132px;
                        vertical-stretch: 0;
                        VerticalBox {
                            padding: 14px;
                            spacing: 10px;
                            LineEdit { placeholder-text: "Enter an authorized account ID"; text <=> root.account-input; }
                            HorizontalBox {
                                spacing: 8px;
                                height: 40px;
                                vertical-stretch: 0;
                                Button { text: "Check status"; enabled: root.core-ready && !root.busy && root.account-input != ""; vertical-stretch: 0; clicked => { root.lookup-account(root.account-input); } }
                                Button { text: "Submit request"; enabled: root.core-ready && !root.busy && root.account-input != ""; vertical-stretch: 0; clicked => { root.submit-task(root.account-input); } }
                            }
                        }
                    }
                    GroupBox {
                        title: "Account projection";
                        max-height: 170px;
                        vertical-stretch: 0;
                        VerticalBox {
                            padding: 14px;
                            spacing: 7px;
                            Text { text: root.account-loaded ? root.account-status : "No account loaded."; font-size: 17px; font-weight: 700; vertical-stretch: 0; }
                            Text { text: root.account-loaded ? "State: " + root.account-state : "Enter an account ID and choose Check status."; color: Palette.alternate-foreground; vertical-stretch: 0; }
                            Text { text: root.account-loaded ? "Revision: " + root.account-revision : ""; color: Palette.alternate-foreground; vertical-stretch: 0; }
                            Text { text: root.account-loaded ? "Current request: " + (root.account-request == "" ? "None" : root.account-request) : ""; color: Palette.alternate-foreground; vertical-stretch: 0; }
                        }
                    }
                    FeedbackBar { text: root.message; accent: root.message-kind == "error" ? #b04a3a : #526c92; vertical-stretch: 0; }
                }
            }

            if root.page == "tasks": ScrollView {
                VerticalBox {
                    padding: 32px;
                    spacing: 18px;
                    PageHeader { title: "Tasks"; subtitle: "Inspect a Core request, its attempts, and its latest failure."; }
                    if !root.core-ready: FeedbackBar { text: "Core is not running. Start Core before checking a request."; accent: #c18a35; vertical-stretch: 0; }
                    GroupBox {
                        title: "Request ID";
                        max-height: 132px;
                        vertical-stretch: 0;
                        VerticalBox {
                            padding: 14px;
                            spacing: 10px;
                            LineEdit { placeholder-text: "Enter a request ID"; text <=> root.request-input; }
                            HorizontalBox {
                                spacing: 8px;
                                height: 40px;
                                vertical-stretch: 0;
                                Button { text: "Refresh status"; enabled: root.core-ready && !root.busy && root.request-input != ""; vertical-stretch: 0; clicked => { root.refresh-task(root.request-input); } }
                                Button { text: "Cancel request"; enabled: root.core-ready && !root.busy && root.request-input != "" && root.task-loaded && root.request-input == root.task-request-id; vertical-stretch: 0; clicked => { root.cancel-task(root.request-input); } }
                                Button { text: "View page"; enabled: root.core-ready && !root.busy && root.task-loaded && root.request-input == root.task-request-id; vertical-stretch: 0; clicked => { root.refresh-view(root.request-input); } }
                            }
                        }
                    }
                    GroupBox {
                        title: "Request projection";
                        max-height: 190px;
                        vertical-stretch: 0;
                        VerticalBox {
                            padding: 14px;
                            spacing: 7px;
                            Text { text: root.task-loaded ? root.task-status : "No request loaded."; font-size: 17px; font-weight: 700; vertical-stretch: 0; }
                            Text { text: root.task-loaded ? "Account: " + root.task-account : "Enter a request ID and choose Refresh status."; color: Palette.alternate-foreground; vertical-stretch: 0; }
                            Text { text: root.task-loaded ? "State: " + root.task-state : ""; color: Palette.alternate-foreground; vertical-stretch: 0; }
                            Text { text: root.task-loaded ? "Attempt: " + root.task-attempt : ""; color: Palette.alternate-foreground; vertical-stretch: 0; }
                            Text { text: root.task-loaded && root.task-failure != "" ? "Latest failure: " + root.task-failure : ""; color: #b04a3a; wrap: word-wrap; vertical-stretch: 0; }
                        }
                    }
                    GroupBox {
                        title: "Browser view";
                        max-height: 430px;
                        vertical-stretch: 0;
                        VerticalBox {
                            padding: 14px;
                            spacing: 8px;
                            Text { text: root.browser-view-status; color: Palette.alternate-foreground; wrap: word-wrap; vertical-stretch: 0; }
                            Rectangle {
                                width: 100%;
                                height: 320px;
                                background: Palette.alternate-background;
                                border-color: Palette.border;
                                border-width: 1px;
                                Image { source: root.browser-view; image-fit: contain; width: parent.width; height: parent.height; }
                            }
                        }
                    }
                    FeedbackBar { text: root.message; accent: root.message-kind == "error" ? #b04a3a : #526c92; vertical-stretch: 0; }
                }
            }

            if root.page == "rdp": ScrollView {
                VerticalBox {
                    padding: 32px;
                    spacing: 18px;
                    PageHeader { title: "RDP session"; subtitle: "Sign in to a local RDP account and open its desktop."; }
                    GroupBox {
                        title: "RDP login";
                        max-height: 420px;
                        vertical-stretch: 0;
                        VerticalBox {
                            padding: 14px;
                            spacing: 10px;
                            LineEdit { placeholder-text: "Host or IP address"; text <=> root.rdp-host; }
                            HorizontalBox {
                                spacing: 8px;
                                LineEdit { placeholder-text: "Port (default 3389)"; text <=> root.rdp-port; }
                                LineEdit { placeholder-text: "Domain (optional)"; text <=> root.rdp-domain; }
                            }
                            LineEdit { placeholder-text: "Username"; text <=> root.rdp-username; }
                            LineEdit { placeholder-text: "Password"; input-type: password; text <=> root.rdp-password; }
                            CheckBox {
                                text: "仅本次接受自签名或名称不匹配的证书";
                                checked: root.rdp-allow-untrusted-certificate;
                                toggled => { root.rdp-allow-untrusted-certificate = self.checked; }
                            }
                            Text {
                                text: "默认拒绝不受信任证书；启用前请核对页面中的证书指纹。此选项不会保存信任。";
                                color: Palette.alternate-foreground;
                                wrap: word-wrap;
                                vertical-stretch: 0;
                            }
                            HorizontalBox {
                                spacing: 8px;
                                height: 40px;
                                vertical-stretch: 0;
                                Button {
                                    text: "Connect";
                                    enabled: !root.busy && root.rdp-host != "";
                                    vertical-stretch: 0;
                                    clicked => {
                                        root.connect-rdp(root.rdp-host, root.rdp-port, root.rdp-domain, root.rdp-username, root.rdp-password, root.rdp-allow-untrusted-certificate);
                                    }
                                }
                                Text { text: root.rdp-status; color: Palette.alternate-foreground; vertical-alignment: center; wrap: word-wrap; }
                            }
                        }
                    }
                    Text { text: "凭据只用于本次 RDP 连接。Chuzi 不会保存密码；连接错误会显示在此页面。"; color: Palette.alternate-foreground; wrap: word-wrap; vertical-stretch: 0; }
                    FeedbackBar { text: root.message; accent: root.message-kind == "error" ? #b04a3a : root.message-kind == "success" ? #4b8c6a : #526c92; vertical-stretch: 0; }
                }
            }

            if root.page == "settings": ScrollView {
                VerticalBox {
                    padding: 32px;
                    spacing: 18px;
                    PageHeader { title: "Settings"; subtitle: "Keep UI appearance separate from Core and launcher behavior."; }
                    GroupBox {
                        title: "Core";
                        max-height: 160px;
                        vertical-stretch: 0;
                        VerticalBox {
                            padding: 14px;
                            spacing: 8px;
                            Text { text: root.core-status; font-size: 17px; font-weight: 700; vertical-stretch: 0; }
                            Text { text: root.data-directory; color: Palette.alternate-foreground; wrap: word-wrap; vertical-stretch: 0; }
                            HorizontalBox {
                                spacing: 8px;
                                height: 40px;
                                vertical-stretch: 0;
                                Button { text: "Start"; enabled: root.core-installed && !root.core-ready && !root.busy; vertical-stretch: 0; clicked => { root.start-core(); } }
                                Button { text: "Stop"; enabled: root.core-ready && !root.busy; vertical-stretch: 0; clicked => { root.stop-core(); } }
                            }
                        }
                    }
                    GroupBox {
                        title: "Components";
                        max-height: 276px;
                        vertical-stretch: 0;
                        VerticalBox {
                            padding: 14px;
                            spacing: 8px;
                            Text { text: root.component-summary; color: Palette.alternate-foreground; wrap: word-wrap; vertical-stretch: 0; }
                            HorizontalBox {
                                spacing: 8px;
                                height: 40px;
                                vertical-stretch: 0;
                                ComboBox {
                                    model: root.component-options;
                                    current-value <=> root.component-input;
                                    enabled: root.component-options.length > 0;
                                }
                                Button { text: "Refresh"; enabled: !root.busy; vertical-stretch: 0; clicked => { root.refresh-components(); } }
                                Button { text: "Install"; enabled: !root.busy && root.component-input != ""; vertical-stretch: 0; clicked => { root.install-component(root.component-input); } }
                                Button { text: "Install Core"; enabled: !root.core-ready && !root.busy; vertical-stretch: 0; clicked => { root.install-core(); } }
                            }
                            HorizontalBox {
                                spacing: 8px;
                                height: 40px;
                                vertical-stretch: 0;
                                Button { text: "Enable"; enabled: !root.busy && root.component-input == root.component-id && root.component-installed && !root.component-enabled; vertical-stretch: 0; clicked => { root.enable-component(root.component-input); } }
                                Button { text: "Disable"; enabled: !root.busy && root.component-input == root.component-id && root.component-installed && root.component-enabled && !root.component-required; vertical-stretch: 0; clicked => { root.disable-component(root.component-input); } }
                                Button { text: "Remove"; enabled: !root.busy && root.component-input == root.component-id && root.component-installed && !root.component-required; vertical-stretch: 0; clicked => { root.remove-component(root.component-input); } }
                            }
                            Text { text: root.component-loaded ? root.component-id : "No component loaded."; font-size: 17px; font-weight: 700; vertical-stretch: 0; }
                            Text { text: root.component-loaded ? "Version: " + root.component-version : "Refresh to read the release manifest."; color: Palette.alternate-foreground; vertical-stretch: 0; }
                            Text { text: root.component-loaded ? "Installed: " + (root.component-installed ? "Yes" : "No") + " | Enabled: " + (root.component-enabled ? "Yes" : "No") + " | Required: " + (root.component-required ? "Yes" : "No") + " | Health: " + root.component-health : ""; color: Palette.alternate-foreground; wrap: word-wrap; vertical-stretch: 0; }
                        }
                    }
                    GroupBox {
                        title: "Updates";
                        max-height: 190px;
                        vertical-stretch: 0;
                        VerticalBox {
                            padding: 14px;
                            spacing: 9px;
                            CheckBox { text: "Check for updates automatically"; checked: root.auto-check-updates; toggled => { root.auto-check-updates = self.checked; } }
                            CheckBox { text: "Repair missing files automatically"; checked: root.auto-repair; toggled => { root.auto-repair = self.checked; } }
                            ComboBox {
                                model: ["Nightly", "Stable"];
                                current-index: root.update-channel == "stable" ? 1 : 0;
                                selected => { root.update-channel = self.current-index == 1 ? "stable" : "nightly"; }
                            }
                            SpinBox { value <=> root.update-interval; minimum: 5; maximum: 10080; }
                            Text { text: "Update check interval (minutes)"; color: Palette.alternate-foreground; font-size: 12px; vertical-stretch: 0; }
                        }
                    }
                    GroupBox {
                        title: "Appearance";
                        max-height: 150px;
                        vertical-stretch: 0;
                        VerticalBox {
                            padding: 14px;
                            spacing: 8px;
                            Text { text: "Choose System, Light, or Dark. The preview applies immediately."; color: Palette.alternate-foreground; wrap: word-wrap; vertical-stretch: 0; }
                            ComboBox {
                                model: ["System default", "Light", "Dark"];
                                current-index: root.theme == "light" ? 1 : root.theme == "dark" ? 2 : 0;
                                selected => {
                                    root.theme = self.current-index == 1 ? "light" : self.current-index == 2 ? "dark" : "system";
                                    root.theme-changed(root.theme);
                                }
                            }
                        }
                    }
                    GroupBox {
                        title: "Startup";
                        max-height: 130px;
                        vertical-stretch: 0;
                        VerticalBox {
                            padding: 14px;
                            spacing: 8px;
                            CheckBox { text: "Launch Chuzi when I sign in"; checked: root.launch-on-login; toggled => { root.launch-on-login = self.checked; } }
                            CheckBox { text: "Keep Chuzi running when the window closes"; checked: root.close-to-tray; toggled => { root.close-to-tray = self.checked; } }
                        }
                    }
                    HorizontalBox {
                        spacing: 10px;
                        height: 40px;
                        vertical-stretch: 0;
                        Button { text: "Save settings"; enabled: !root.busy; vertical-stretch: 0; clicked => { root.save-settings(); } }
                        Text { text: root.busy ? "Saving..." : ""; color: Palette.alternate-foreground; vertical-alignment: center; }
                    }
                    FeedbackBar { text: root.message; accent: root.message-kind == "error" ? #b04a3a : root.message-kind == "success" ? #4b8c6a : #526c92; vertical-stretch: 0; }
                }
            }
        }
    }
}

component RdpBarButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <length> button-width: 80px;
    in property <bool> enabled: true;
    callback pressed();

    width: root.button-width;
    height: 32px;
    background: transparent;
    opacity: root.enabled ? 1.0 : 0.45;

    Text {
        text: root.icon;
        color: #f4f4f4;
        font-size: 15px;
        x: 7px;
        y: 0px;
        width: 18px;
        height: 32px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        text: root.label;
        color: #f4f4f4;
        font-size: 12px;
        x: 29px;
        y: 0px;
        width: root.button-width - 37px;
        height: 32px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    TouchArea {
        enabled: root.enabled;
        clicked => { root.pressed(); }
    }
}

component RdpIconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> active: false;
    callback pressed();

    width: 40px;
    height: 32px;
    background: transparent;

    Text {
        text: root.icon;
        color: root.active ? #60b9f4 : #f4f4f4;
        font-size: 17px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    TouchArea { clicked => { root.pressed(); } }
}

component WindowChromeButton inherits Rectangle {
    in property <string> icon;
    in property <color> hover-color: #2d2d2d;
    in property <color> pressed-color: #3a3a3a;
    callback pressed();

    width: 46px;
    height: 32px;
    background: touch-area.pressed ? root.pressed-color : touch-area.has-hover ? root.hover-color : transparent;

    Text {
        text: root.icon;
        color: #f4f4f4;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    touch-area := TouchArea {
        clicked => { root.pressed(); }
    }
}

export component DesktopRdpWindow inherits Window {
    title: "RDP 连接";
    min-width: 415px;
    min-height: 90px;
    preferred-width: 1280px;
    preferred-height: 752px;
    no-frame: true;
    resize-border-width: 1px;
    always-on-top: root.topmost;

    in-out property <string> host: "localhost";
    in-out property <string> state: "not-started";
    in-out property <string> status: "";
    in-out property <image> frame;
    in-out property <bool> mouse-game-mode: false;
    in-out property <bool> audio-enabled: true;
    in-out property <bool> topmost: false;
    in-out property <bool> show-control-menu: false;
    in-out property <bool> notification-visible: false;
    in-out property <bool> small-window: false;
    in-out property <bool> keep-aspect-ratio: true;

    property <bool> connected: root.state == "connected";
    property <color> state-color: root.state == "connected" ? #32cd32 : root.state == "closing" ? #ffb900 : root.state == "connecting" ? #1e90ff : #e55353;
    property <string> state-title: root.state == "connected" ? "RDP 已连接" : root.state == "connecting" ? "正在连接 RDP" : root.state == "started" ? "RDP 已启动，等待连接" : root.state == "closing" ? "正在关闭 RDP" : root.state == "failed" ? "RDP 连接失败" : "RDP 尚未连接";
    property <string> state-description: root.state == "connected" ? "RDP 画面已接入 FreeRDP framebuffer。" : root.state == "connecting" ? "正在创建 RDP 连接，请稍候。" : root.state == "started" ? "RDP 会话仍在运行，点击“连接”可重新建立连接。" : root.state == "closing" ? "正在断开 RDP 并释放连接资源。" : root.state == "failed" ? "FreeRDP 无法建立连接，请检查目标地址和凭据。" : "点击“连接”，建立到目标桌面的 RDP 连接。";
    property <string> rdp-status: root.state == "connected" ? "RDP 已连接" : root.state == "connecting" ? "RDP 正在连接" : root.state == "closing" ? "正在断开 RDP" : root.state == "failed" ? "RDP 连接失败" : "RDP 未连接";
    property <string> session-status: root.state == "not-started" ? "RDP 会话未创建" : root.state == "closing" ? "RDP 会话正在释放" : root.state == "failed" ? "RDP 会话未建立" : "RDP 会话已创建";
    property <string> detail-status: root.status != "" ? root.status : root.state == "connected" ? "远程桌面画面区域已准备好。" : "FreeRDP 会话尚未返回远程桌面画面。";
    property <bool> compact-layout: root.width < 620px || root.height < 420px;

    callback hide-window();

    background: #141414;

    Rectangle {
        background: #000000;

        VerticalBox {
            spacing: 0px;

            Rectangle {
                height: 32px;
                    background: #141414;
                vertical-stretch: 0;

                WindowMoveArea {
                    width: parent.width;
                    height: parent.height;
                }

                Rectangle {
                    x: 10px;
                    y: 7px;
                    width: 16px;
                    height: 12px;
                    border-radius: 3px;
                    background: #202a3a;
                    border-color: #60b9f4;
                    border-width: 1px;
                }
                Rectangle { x: 16px; y: 19px; width: 4px; height: 3px; background: #60b9f4; }
                Rectangle { x: 13px; y: 22px; width: 10px; height: 1px; background: #60b9f4; }
                Rectangle { x: 39px; y: 12px; width: 9px; height: 9px; border-radius: 5px; background: root.state-color; }
                Text { x: 56px; y: 0px; width: root.width - 360px; height: 32px; text: "RDP 连接"; color: #f4f4f4; font-size: 12px; vertical-alignment: center; overflow: elide; }

                RdpBarButton {
                    x: root.width - 718px;
                    y: 0px;
                    label: "连接";
                    icon: "▶";
                    button-width: 80px;
                    visible: root.width >= 760px;
                    pressed => { root.state = "connecting"; root.show-control-menu = false; }
                }
                RdpBarButton {
                    x: root.width - 638px;
                    y: 0px;
                    label: "隐藏";
                    icon: "◌";
                    button-width: 80px;
                    visible: root.width >= 680px;
                    pressed => { root.hide-window(); }
                }
                RdpBarButton {
                    x: root.width - 558px;
                    y: 0px;
                    label: "切换窗口";
                    icon: "⇄";
                    button-width: 110px;
                    visible: root.width >= 570px;
                    pressed => { root.state = root.state == "connected" ? "started" : "connected"; }
                }
                RdpBarButton {
                    x: root.width - 448px;
                    y: 0px;
                    label: root.mouse-game-mode ? "游戏鼠标" : "普通鼠标";
                    icon: root.mouse-game-mode ? "⌖" : "⌁";
                    button-width: 110px;
                    visible: root.width >= 470px;
                    pressed => { root.mouse-game-mode = !root.mouse-game-mode; }
                }
                RdpBarButton {
                    x: root.width - 338px;
                    y: 0px;
                    label: "连接设置";
                    icon: "▦";
                    button-width: 120px;
                    pressed => { root.show-control-menu = !root.show-control-menu; }
                }
                RdpIconButton {
                    x: root.width - 218px;
                    y: 0px;
                    icon: root.audio-enabled ? "◖" : "◗";
                    pressed => { root.audio-enabled = !root.audio-enabled; }
                }
                RdpIconButton {
                    x: root.width - 178px;
                    y: 0px;
                    icon: root.topmost ? "◆" : "◇";
                    active: root.topmost;
                    pressed => { root.topmost = !root.topmost; }
                }

                WindowChromeButton {
                    x: root.width - 138px;
                    y: 0px;
                    icon: "—";
                    pressed => { root.minimized = true; }
                }
                WindowChromeButton {
                    x: root.width - 92px;
                    y: 0px;
                    icon: root.maximized ? "❐" : "□";
                    pressed => { root.maximized = !root.maximized; }
                }
                WindowChromeButton {
                    x: root.width - 46px;
                    y: 0px;
                    icon: "×";
                    hover-color: #c42b1c;
                    pressed-color: #a5261a;
                    pressed => { root.close(); }
                }
            }

            Rectangle {
                background: #000000;
                vertical-stretch: 1;

                if root.state == "connected": Rectangle {
                    background: #000000;

                    Image {
                        source: root.frame;
                        image-fit: contain;
                        width: parent.width;
                        height: parent.height;
                    }

                    TouchArea {
                        width: parent.width;
                        height: parent.height;
                        pointer-event(event) => {
                            root.rdp-pointer-event(
                                event.kind == PointerEventKind.move ? "move" :
                                event.kind == PointerEventKind.down ? "down" :
                                event.kind == PointerEventKind.up ? "up" : "cancel",
                                event.button == PointerEventButton.left ? "left" :
                                event.button == PointerEventButton.right ? "right" :
                                event.button == PointerEventButton.middle ? "middle" : "other",
                                self.mouse-x, self.mouse-y, parent.width, parent.height);
                        }
                    }

                    Rectangle {
                        x: 12px;
                        y: parent.height - 34px;
                        width: 190px;
                        height: 22px;
                        background: #00000099;
                        border-radius: 4px;
                        Text {
                            x: 8px;
                            width: parent.width - 16px;
                            height: parent.height;
                            text: root.status;
                            color: #ffffffcc;
                            font-size: 11px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                if root.state != "connected": Rectangle {
                    width: parent.width < 532px ? parent.width - 52px : 480px;
                    height: root.compact-layout ? parent.height - 64px : 436px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    background: #171717;
                    border-color: #ffffff33;
                    border-width: 1px;
                    border-radius: 12px;

                    Rectangle {
                        width: parent.width;
                        height: parent.height;
                        background: transparent;

                        Rectangle {
                            x: (parent.width - 72px) / 2;
                            y: root.compact-layout ? 28px : 30px;
                            width: 72px;
                            height: 72px;
                            border-radius: 36px;
                            background: root.state == "closing" ? #ffb90026 : #262fa4e7;
                            if root.state == "closing": Text {
                                text: "◌";
                                color: #ffc83d;
                                font-size: 33px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: parent.width;
                                height: parent.height;
                            }
                            if root.state != "closing": Rectangle {
                                x: 20px;
                                y: 21px;
                                width: 32px;
                                height: 23px;
                                background: transparent;
                                border-color: #60b9f4;
                                border-width: 2px;
                                border-radius: 2px;
                            }
                            if root.state != "closing": Rectangle { x: 34px; y: 44px; width: 4px; height: 8px; background: #60b9f4; }
                            if root.state != "closing": Rectangle { x: 27px; y: 51px; width: 18px; height: 2px; background: #60b9f4; }
                        }

                        Rectangle {
                            x: (parent.width - 280px) / 2;
                            y: root.compact-layout ? 118px : 124px;
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: root.state-color;
                        }
                        Text {
                            x: (parent.width - 280px) / 2 + 19px;
                            y: root.compact-layout ? 111px : 117px;
                            width: 261px;
                            height: 28px;
                            text: root.state-title;
                            color: #ffffff;
                            font-size: 21px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }
                        Text {
                            x: 32px;
                            y: root.compact-layout ? 153px : 163px;
                            width: parent.width - 64px;
                            height: root.compact-layout ? 48px : 38px;
                            text: root.state-description;
                            color: #ffffffbf;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }

                        if !root.compact-layout: Rectangle {
                            x: 32px;
                            y: 210px;
                            width: parent.width - 64px;
                            height: 92px;
                            background: #10000000;
                            border-color: #ffffff24;
                            border-width: 1px;
                            border-radius: 7px;
                            Text { x: 12px; y: 12px; width: parent.width - 24px; height: 18px; text: root.rdp-status; color: #ffffffe6; font-size: 13px; }
                            Text { x: 12px; y: 35px; width: parent.width - 24px; height: 18px; text: root.session-status; color: #ffffff99; font-size: 12px; }
                            Text { x: 12px; y: 61px; width: parent.width - 24px; height: 20px; text: root.detail-status; color: #ffffff70; font-size: 11px; wrap: word-wrap; }
                        }

                        if !root.compact-layout && root.state != "closing": Rectangle {
                            x: (parent.width - 248px) / 2;
                            y: 324px;
                            width: 132px;
                            height: 36px;
                            background: #2fa4e7;
                            border-radius: 6px;
                            Text { x: 12px; y: 0px; width: 18px; height: 36px; text: "▷"; color: white; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
                            Text { x: 34px; y: 0px; width: 86px; height: 36px; text: "连接"; color: white; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.state = "connecting"; } }
                        }
                        if !root.compact-layout && root.state != "closing": Rectangle {
                            x: (parent.width - 248px) / 2 + 148px;
                            y: 324px;
                            width: 100px;
                            height: 34px;
                            background: transparent;
                            Text { width: parent.width; height: parent.height; text: "查看帮助文档"; color: #60b9f4; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.notification-visible = true; } }
                        }

                        if !root.compact-layout && root.state != "closing": Text { x: 32px; y: 379px; width: parent.width - 64px; height: 16px; text: "连接成功后，此处会自动切换为远程桌面画面。"; color: #ffffff80; font-size: 11px; horizontal-alignment: center; }
                        if !root.compact-layout && root.state != "closing": Text { x: 32px; y: 397px; width: parent.width - 64px; height: 16px; text: "游戏鼠标模式下，按住 Alt 可临时释放本地鼠标。"; color: #ffffff80; font-size: 11px; horizontal-alignment: center; }
                        if !root.compact-layout && root.state == "closing": Text { x: 32px; y: 379px; width: parent.width - 64px; height: 16px; text: "请稍候，关闭完成后窗口会自动隐藏。"; color: #ffffffcc; font-size: 11px; horizontal-alignment: center; }
                        if !root.compact-layout && root.state == "closing": Text { x: 32px; y: 397px; width: parent.width - 64px; height: 16px; text: "关闭期间已暂停所有 RDP 操作，以避免状态冲突。"; color: #ffffff80; font-size: 11px; horizontal-alignment: center; }
                    }
                }
            }
        }
    }

    callback rdp-pointer-event(kind: string, button: string, x: length, y: length, viewport-width: length, viewport-height: length);

    if root.show-control-menu: Rectangle {
        x: root.width - 308px;
        y: 34px;
        width: 300px;
        height: 360px;
        background: #202020;
        border-color: #ffffff40;
        border-width: 1px;
        border-radius: 8px;
        z: 10;

        VerticalBox {
            padding: 8px;
            spacing: 2px;
            Text { text: "连接设置"; color: #ffffff; font-size: 13px; font-weight: 600; vertical-stretch: 0; }
            Rectangle { height: 3px; background: transparent; vertical-stretch: 0; }
            Rectangle { height: 28px; background: transparent; Text { text: "重新连接"; color: #f4f4f4; vertical-alignment: center; width: parent.width; height: parent.height; } TouchArea { clicked => { root.state = "connecting"; root.show-control-menu = false; } } }
            Rectangle { height: 28px; background: transparent; Text { text: root.small-window ? "还原窗口" : "小窗模式"; color: #f4f4f4; vertical-alignment: center; width: parent.width; height: parent.height; } TouchArea { clicked => { root.small-window = !root.small-window; root.show-control-menu = false; } } }
            Rectangle { height: 1px; background: #ffffff35; vertical-stretch: 0; }
            Text { text: "远程桌面分辨率"; color: #ffffff90; font-size: 11px; vertical-stretch: 0; }
            Rectangle { height: 26px; background: transparent; Text { text: "    1920 × 1080"; color: #f4f4f4; vertical-alignment: center; width: parent.width; height: parent.height; } }
            Text { text: "窗口"; color: #ffffff90; font-size: 11px; vertical-stretch: 0; }
            Rectangle { height: 26px; background: transparent; Text { text: "    自适应"; color: #f4f4f4; vertical-alignment: center; width: parent.width; height: parent.height; } }
            Rectangle { height: 26px; background: transparent; Text { text: "    1 : 1"; color: #f4f4f4; vertical-alignment: center; width: parent.width; height: parent.height; } }
            Rectangle { height: 1px; background: #ffffff35; vertical-stretch: 0; }
            Rectangle { height: 26px; background: transparent; Text { text: root.keep-aspect-ratio ? "✓   保持宽高比" : "    保持宽高比"; color: #f4f4f4; vertical-alignment: center; width: parent.width; height: parent.height; } TouchArea { clicked => { root.keep-aspect-ratio = !root.keep-aspect-ratio; } } }
            Text { text: "快捷键"; color: #ffffff90; font-size: 11px; vertical-stretch: 0; }
            Rectangle { height: 26px; background: transparent; Text { text: "    系统组合键发送到远程桌面"; color: #f4f4f4; vertical-alignment: center; width: parent.width; height: parent.height; } }
            Rectangle { height: 1px; background: #ffffff35; vertical-stretch: 0; }
            Rectangle { height: 26px; background: transparent; Text { text: "    发送 Win+D 显示桌面"; color: #f4f4f4; vertical-alignment: center; width: parent.width; height: parent.height; } }
            Rectangle { height: 26px; background: transparent; Text { text: "    发送 Win+Tab 切换窗口"; color: #f4f4f4; vertical-alignment: center; width: parent.width; height: parent.height; } }
            Text { text: "更多"; color: #ffffff90; font-size: 11px; vertical-stretch: 0; }
            Rectangle { height: 28px; background: transparent; Text { text: "    打开连接诊断…"; color: #f4f4f4; vertical-alignment: center; width: parent.width; height: parent.height; } }
        }
    }

    if root.notification-visible: Rectangle {
        x: 8px;
        y: 40px;
        width: root.width - 16px;
        height: 54px;
        background: #252525;
        border-color: #ffffff45;
        border-width: 1px;
        border-radius: 8px;
        z: 20;
        HorizontalBox {
            padding-left: 16px;
            padding-right: 10px;
            spacing: 10px;
            Text { text: "ⓘ"; color: #60b9f4; font-size: 18px; vertical-alignment: center; vertical-stretch: 1; }
            VerticalBox {
                spacing: 2px;
                vertical-stretch: 1;
                Text { text: "RDP 连接界面"; color: #ffffff; font-size: 12px; font-weight: 600; vertical-stretch: 0; }
                Text { text: "FreeRDP 会话画面会直接显示在连接窗口中；凭据只在本次 Windows 登录提示中使用。"; color: #ffffffbf; font-size: 11px; wrap: word-wrap; vertical-stretch: 1; }
            }
            Rectangle { width: 24px; background: transparent; vertical-stretch: 1; Text { text: "×"; color: #d0d0d0; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } TouchArea { clicked => { root.notification-visible = false; } } }
        }
    }
}
