import { Button, CheckBox, ComboBox, GroupBox, LineEdit, Palette, ScrollView, SpinBox, VerticalBox, HorizontalBox } from "std-widgets.slint";
export { Palette } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Chuzi";
    min-width: 760px;
    min-height: 540px;
    preferred-width: 1120px;
    preferred-height: 760px;

    in-out property <string> page: "overview";
    in-out property <string> theme: "system";
    in-out property <string> core-status: "Checking Core...";
    in-out property <string> core-details: "";
    in-out property <string> data-directory: "";
    in-out property <string> message: "";
    in-out property <bool> busy: false;
    in-out property <bool> core-ready: false;
    in-out property <string> account-input: "";
    in-out property <string> request-input: "";
    in-out property <string> account-status: "No account loaded.";
    in-out property <string> task-status: "No task loaded.";
    in-out property <string> plugin-summary: "Core is not ready. Start Core to load plugins.";
    in-out property <bool> auto-check-updates: false;
    in-out property <bool> auto-repair: false;
    in-out property <bool> launch-on-login: false;
    in-out property <bool> close-to-tray: false;
    in-out property <int> update-interval: 60;

    callback install-core();
    callback start-core();
    callback stop-core();
    callback refresh-core();
    callback save-settings();
    callback theme-changed(string);
    callback refresh-plugins();
    callback install-plugin();
    callback trust-plugin();
    callback enable-plugin();
    callback remove-plugin();
    callback lookup-account(string);
    callback submit-task(string);
    callback refresh-task(string);
    callback cancel-task(string);

    background: Palette.background;

    HorizontalBox {
        spacing: 0px;

        Rectangle {
            preferred-width: 218px;
            min-width: 190px;
            max-width: 250px;
            background: Palette.alternate-background;
            border-color: Palette.border;
            border-width: 1px;
            VerticalBox {
                padding-top: 22px;
                padding-bottom: 22px;
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;
                Text { text: "Chuzi"; color: Palette.foreground; font-size: 24px; font-weight: 700; horizontal-alignment: center; vertical-stretch: 0; }
                Text { text: "CONTROL CENTER"; color: Palette.alternate-foreground; font-size: 11px; horizontal-alignment: center; vertical-stretch: 0; }
                Rectangle { height: 12px; background: transparent; }
                Button { text: "Overview"; clicked => { root.page = "overview"; } }
                Button { text: "Plugins"; clicked => { root.page = "plugins"; } }
                Button { text: "Accounts"; clicked => { root.page = "accounts"; } }
                Button { text: "Tasks"; clicked => { root.page = "tasks"; } }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Button { text: "Settings"; clicked => { root.page = "settings"; } }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: Palette.background;

            if root.page == "overview": ScrollView {
                VerticalBox {
                    padding: 36px;
                    spacing: 24px;
                    Text { text: "Welcome to Chuzi"; font-size: 30px; font-weight: 700; color: Palette.foreground; }
                    Text { text: "Install Core, configure plugins, and personalize the client from one place."; color: Palette.alternate-foreground; wrap: word-wrap; }
                    Rectangle {
                        border-width: 1px;
                        border-color: Palette.border;
                        background: Palette.alternate-background;
                        border-radius: 6px;
                        min-height: 132px;
                        preferred-height: 132px;
                        HorizontalBox {
                            padding: 18px;
                            spacing: 16px;
                            Text { text: "●"; color: #2a9d67; font-size: 26px; vertical-alignment: top; }
                            VerticalBox {
                                horizontal-stretch: 1;
                                spacing: 5px;
                                Text { text: root.core-status; font-size: 20px; font-weight: 700; color: Palette.foreground; }
                                Text { text: root.core-details; color: Palette.alternate-foreground; wrap: word-wrap; }
                                Text { text: root.data-directory; color: Palette.alternate-foreground; font-size: 12px; wrap: word-wrap; }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            if root.busy: Text { text: "Working..."; color: Palette.alternate-foreground; vertical-alignment: center; }
                        }
                    }
                    HorizontalBox {
                        spacing: 10px;
                        Button { text: "Install Core"; enabled: !root.core-ready && root.core-status == "Core is not installed" && !root.busy; clicked => { root.install-core(); } }
                        Button { text: "Start Core"; enabled: !root.core-ready && root.core-status != "Core is not installed" && !root.busy; clicked => { root.start-core(); } }
                        Button { text: "Stop Core"; enabled: root.core-ready && !root.busy; clicked => { root.stop-core(); } }
                        Button { text: "Refresh"; enabled: !root.busy; clicked => { root.refresh-core(); } }
                    }
                    GroupBox {
                        title: "First-run checklist";
                        VerticalBox {
                            padding: 14px;
                            spacing: 8px;
                            Text { text: root.core-ready ? "1. Core is ready" : "1. Install or start Core"; }
                            Text { text: root.core-ready ? "2. Configure plugins in Plugins" : "2. Configure plugins after Core starts"; color: Palette.alternate-foreground; }
                            Text { text: "3. Personalize settings when you are ready"; color: Palette.alternate-foreground; }
                        }
                    }
                    if root.message != "": Text { text: root.message; color: #9a3d32; wrap: word-wrap; }
                }
            }

            if root.page == "settings": ScrollView {
                VerticalBox {
                    padding: 36px;
                    spacing: 24px;
                    Text { text: "Settings"; font-size: 30px; font-weight: 700; color: Palette.foreground; }
                    Text { text: "Manage Core lifecycle, updates, appearance, and startup behavior."; color: Palette.alternate-foreground; wrap: word-wrap; }
                    GroupBox {
                        title: "Core";
                        VerticalBox {
                            padding: 14px;
                            spacing: 8px;
                            Text { text: root.core-status; font-size: 17px; font-weight: 700; }
                            Text { text: root.data-directory; color: Palette.alternate-foreground; wrap: word-wrap; }
                            HorizontalBox {
                                spacing: 10px;
                                Button { text: "Install / Replace Core"; enabled: !root.busy; clicked => { root.install-core(); } }
                                Button { text: "Start"; enabled: !root.core-ready && !root.busy; clicked => { root.start-core(); } }
                                Button { text: "Stop"; enabled: root.core-ready && !root.busy; clicked => { root.stop-core(); } }
                            }
                        }
                    }
                    GroupBox {
                        title: "Updates";
                        VerticalBox {
                            padding: 14px;
                            spacing: 8px;
                            CheckBox { text: "Check for updates automatically"; checked: root.auto-check-updates; toggled => { root.auto-check-updates = self.checked; } }
                            CheckBox { text: "Repair missing files automatically"; checked: root.auto-repair; toggled => { root.auto-repair = self.checked; } }
                            ComboBox { model: ["Nightly", "Stable"]; current-index: 0; }
                            SpinBox { value: root.update-interval; minimum: 0; maximum: 10080; }
                        }
                    }
                    GroupBox {
                        title: "Appearance";
                        VerticalBox {
                            padding: 14px;
                            spacing: 8px;
                            Text { text: "Choose how Chuzi follows your system."; color: Palette.alternate-foreground; wrap: word-wrap; }
                            ComboBox {
                                model: ["System default", "Light", "Dark"];
                                current-index: root.theme == "light" ? 1 : root.theme == "dark" ? 2 : 0;
                                selected => {
                                    root.theme = self.current-index == 1 ? "light" : self.current-index == 2 ? "dark" : "system";
                                    root.theme-changed(root.theme);
                                }
                            }
                        }
                    }
                    GroupBox {
                        title: "Startup";
                        VerticalBox {
                            padding: 14px;
                            spacing: 8px;
                            CheckBox { text: "Launch Chuzi when I sign in"; checked: root.launch-on-login; toggled => { root.launch-on-login = self.checked; } }
                            CheckBox { text: "Keep Chuzi running when the window closes"; checked: root.close-to-tray; toggled => { root.close-to-tray = self.checked; } }
                        }
                    }
                    HorizontalBox {
                        spacing: 10px;
                        Button { text: "Save settings"; enabled: !root.busy; clicked => { root.save-settings(); } }
                        if root.message != "": Text { text: root.message; color: #3d6f58; vertical-alignment: center; }
                    }
                }
            }

            if root.page == "plugins": ScrollView {
                VerticalBox {
                    padding: 34px;
                    spacing: 18px;
                    Text { text: "Plugins"; font-size: 30px; font-weight: 700; color: Palette.foreground; }
                    Text { text: "Review permissions and trust before enabling a plugin."; color: Palette.alternate-foreground; wrap: word-wrap; }
                    if !root.core-ready: Text { text: "Start Core before installing, trusting, enabling, or removing plugins."; color: #d29a4a; wrap: word-wrap; }
                    GroupBox {
                        title: "Installed and available plugins";
                        VerticalBox {
                            padding: 14px;
                            spacing: 8px;
                            Text { text: root.plugin-summary; color: Palette.alternate-foreground; wrap: word-wrap; }
                            HorizontalBox {
                                spacing: 10px;
                                Button { text: "Refresh"; enabled: root.core-ready && !root.busy; clicked => { root.refresh-plugins(); } }
                                Button { text: "Install"; enabled: root.core-ready && !root.busy; clicked => { root.install-plugin(); } }
                                Button { text: "Trust"; enabled: root.core-ready && !root.busy; clicked => { root.trust-plugin(); } }
                                Button { text: "Enable"; enabled: root.core-ready && !root.busy; clicked => { root.enable-plugin(); } }
                                Button { text: "Remove"; enabled: root.core-ready && !root.busy; clicked => { root.remove-plugin(); } }
                            }
                        }
                    }
                }
            }

            if root.page == "accounts": ScrollView {
                VerticalBox {
                    padding: 34px;
                    spacing: 18px;
                    Text { text: "Accounts"; font-size: 30px; font-weight: 700; color: Palette.foreground; }
                    Text { text: "Look up a redacted account state or submit a new task."; color: Palette.alternate-foreground; wrap: word-wrap; }
                    if !root.core-ready: Text { text: "Start Core before looking up an account."; color: #d29a4a; }
                    GroupBox {
                        title: "Account ID";
                        VerticalBox {
                            padding: 14px;
                            spacing: 10px;
                            LineEdit { placeholder-text: "Enter an authorized account ID"; text <=> root.account-input; }
                            HorizontalBox {
                                spacing: 10px;
                                Button { text: "Check status"; enabled: root.core-ready && !root.busy; clicked => { root.lookup-account(root.account-input); } }
                                Button { text: "Submit task"; enabled: root.core-ready && !root.busy; clicked => { root.submit-task(root.account-input); } }
                            }
                        }
                    }
                    GroupBox { title: "Account status"; VerticalBox { padding: 14px; Text { text: root.account-status; color: Palette.alternate-foreground; wrap: word-wrap; } } }
                }
            }

            if root.page == "tasks": ScrollView {
                VerticalBox {
                    padding: 34px;
                    spacing: 18px;
                    Text { text: "Tasks"; font-size: 30px; font-weight: 700; color: Palette.foreground; }
                    Text { text: "Track a Core request and cancel it when it is still active."; color: Palette.alternate-foreground; wrap: word-wrap; }
                    if !root.core-ready: Text { text: "Start Core before checking task status."; color: #d29a4a; }
                    GroupBox {
                        title: "Request ID";
                        VerticalBox {
                            padding: 14px;
                            spacing: 10px;
                            LineEdit { placeholder-text: "Enter a request ID"; text <=> root.request-input; }
                            HorizontalBox {
                                spacing: 10px;
                                Button { text: "Refresh status"; enabled: root.core-ready && !root.busy; clicked => { root.refresh-task(root.request-input); } }
                                Button { text: "Cancel task"; enabled: root.core-ready && !root.busy; clicked => { root.cancel-task(root.request-input); } }
                            }
                        }
                    }
                    GroupBox { title: "Task status"; VerticalBox { padding: 14px; Text { text: root.task-status; color: Palette.alternate-foreground; wrap: word-wrap; } } }
                }
            }
        }
    }
}
