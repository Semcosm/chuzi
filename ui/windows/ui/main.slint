import { Button, CheckBox, ComboBox, LineEdit, Palette, ScrollView, SpinBox, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { ChuziTheme } from "design_tokens.slint";
import { ChuziTitlebar, ChuziSidebar } from "shell_components.slint";
import { SessionRowData, ChuziActionButton, ChuziFilterChip, ChuziSessionRow, ChuziSessionInspector, ChuziSessionWorkspace } from "sessions_components.slint";
import { JobPoolRowData, EnvironmentRowData, ChuziJobPoolCard, ChuziEnvironmentCard } from "job_pool_components.slint";
export { Palette } from "std-widgets.slint";

component FeedbackBar inherits Rectangle {
    in property <string> text;
    in property <string> kind: "info";
    height: root.text == "" ? 0px : 38px;
    visible: root.text != "";
    background: root.kind == "error" ? ChuziTheme.status-danger.with-alpha(0.10) :
        root.kind == "success" ? ChuziTheme.status-positive.with-alpha(0.10) : ChuziTheme.surface-background;
    border-color: root.kind == "error" ? ChuziTheme.status-danger :
        root.kind == "success" ? ChuziTheme.status-positive : ChuziTheme.separator;
    border-width: 1px;
    border-radius: ChuziTheme.radius-small;
    Text {
        text: root.text;
        color: root.kind == "error" ? ChuziTheme.status-danger :
            root.kind == "success" ? ChuziTheme.status-positive : ChuziTheme.text-secondary;
        font-size: ChuziTheme.type-caption;
        vertical-alignment: center;
        x: 12px;
        width: parent.width - 24px;
        overflow: elide;
    }
}

export component MainWindow inherits Window {
    title: "Chuzi · Sessions";
    min-width: 800px;
    min-height: 600px;
    preferred-width: 1120px;
    preferred-height: 760px;

    in-out property <string> theme: "system";
    in-out property <string> page: "sessions";
    in-out property <string> message: "";
    in-out property <string> message-kind: "info";
    in-out property <bool> busy: false;
    in-out property <string> busy-operation: "";
    in-out property <bool> core-ready: false;
    in-out property <bool> core-installed: false;
    in-out property <bool> core-status-known: false;
    in-out property <string> core-status: "Checking Core";
    in-out property <string> core-details: "Checking the local Core service.";
    in-out property <bool> diagnostic-consent-visible: false;
    in-out property <bool> diagnostic-submitting: false;
    in-out property <string> diagnostic-consent-summary: "";
    in-out property <string> diagnostic-consent-category: "ui";
    in-out property <string> diagnostic-consent-severity: "error";

    in-out property <[SessionRowData]> session-rows: [];
    in-out property <string> session-phase: "loading";
    in-out property <string> session-filter: "all";
    in-out property <string> session-search: "";
    in-out property <string> session-collection-message: "Loading requests…";
    in-out property <bool> session-has-more-requests: false;
    in-out property <bool> session-inspector-selected: false;
    in-out property <string> session-inspector-request-id: "";
    in-out property <string> session-inspector-account-label: "";
    in-out property <string> session-inspector-status-label: "";
    in-out property <string> session-inspector-attempt-label: "";
    in-out property <string> session-inspector-created-at: "";
    in-out property <string> session-inspector-updated-at: "";
    in-out property <string> session-inspector-failure-label: "";
    in-out property <string> session-inspector-primary-action: "none";
    in-out property <string> session-inspector-primary-label: "";
    in-out property <bool> session-inspector-has-more-action: false;
    in-out property <bool> session-inspector-menu-open: false;
    in-out property <image> session-browser-view;
    in-out property <bool> session-browser-view-loaded: false;
    in-out property <string> session-browser-view-status: "";
    in-out property <bool> inspector-open: false;
    in-out property <bool> compact-shell: false;
    in-out property <bool> inspector-collapsed: false;
    in-out property <bool> snapshot-focus: false;
    in-out property <bool> cancel-confirmation-visible: false;
    in-out property <string> cancel-confirmation-request-id: "";
    in-out property <string> cancel-confirmation-account-label: "";
    in-out property <bool> session-workspace-visible: false;
    in-out property <string> session-workspace-host: "docked";
    in-out property <string> session-workspace-state: "starting";
    in-out property <string> session-workspace-status: "Interactive RDP is not available.";
    in-out property <image> session-workspace-frame;

    in-out property <bool> auto-check-updates: false;
    in-out property <bool> auto-repair: false;
    in-out property <string> update-channel: "nightly";
    in-out property <bool> launch-on-login: false;
    in-out property <bool> close-to-tray: false;
    in-out property <bool> start-core-on-launch: false;
    in-out property <int> update-interval: 60;
    in-out property <string> settings-phase: "loading";
    in-out property <string> job-pool-phase: "idle";
    in-out property <string> job-pool-summary: "Job pool status has not been loaded.";
    in-out property <[JobPoolRowData]> job-pool-rows: [];
    in-out property <[EnvironmentRowData]> environment-rows: [];
    in-out property <string> operation-phase: "idle";
    in-out property <string> operation-id: "";
    in-out property <string> operation-state: "";
    in-out property <string> operation-detail: "";
    in-out property <string> operation-pool-id: "";
    in-out property <string> operation-environment-id: "";
    in-out property <string> operation-environment-version: "";
    in-out property <string> operation-kind: "";
    in-out property <string> job-pool-edit-id: "";
    in-out property <string> job-pool-edit-environment-id: "";
    in-out property <string> job-pool-edit-environment-version: "";
    in-out property <int> job-pool-edit-desired: 0;
    in-out property <int> job-pool-edit-max: 0;
    in-out property <string> package-reference: "";
    in-out property <string> environment-operation-phase: "idle";
    in-out property <bool> operation-confirmation-visible: false;
    in-out property <string> operation-confirmation-title: "Confirm operation";
    in-out property <string> operation-confirmation-message: "";
    in-out property <string> pending-operation: "";
    in-out property <string> pending-pool-id: "";
    in-out property <string> pending-environment-id: "";
    in-out property <string> pending-environment-version: "";
    in-out property <string> pending-environment-generation: "0";

    callback install-core();
    callback start-core();
    callback stop-core();
    callback refresh-core();
    callback refresh-job-pools();
    callback job-pool-apply(string, string, string, int, int);
    callback job-pool-action(string, string);
    callback job-pool-operation(string);
    callback environment-operation(string, string, string, string);
    callback environment-operation-poll(string);
    callback operation-confirmed();
    callback operation-cancelled();
    callback navigate(string);
    callback save-settings();
    callback theme-changed(string);
    callback refresh-sessions();
    callback load-more-sessions();
    callback session-filter-changed(string);
    callback session-search-changed(string);
    callback select-session(string);
    callback move-session-selection(string);
    callback session-primary-action(string, string);
    callback session-cancel-confirmed(string);
    callback session-more-action(string, string);
    callback diagnostic-save();
    callback diagnostic-open();
    callback diagnostic-dismiss();
    callback session-workspace-dock();
    callback session-workspace-float();
    callback session-workspace-hide();
    callback session-workspace-stop();

    changed width => {
        root.compact-shell = root.width < 940px;
        root.inspector-collapsed = root.width < 1200px;
        if root.width >= 1200px { root.inspector-open = false; }
    }

    background: ChuziTheme.window-background;

    property <length> compact-inspector-top: ChuziTheme.titlebar-height + 186px;

    VerticalBox {
        spacing: 0px;

        ChuziTitlebar {
            page: root.page;
            theme: root.theme;
            core-ready: root.core-ready;
            core-status-known: root.core-status-known;
            theme-request(theme) => {
                root.theme = theme;
                root.theme-changed(theme);
            }
            core-status-request => { root.refresh-core(); }
            vertical-stretch: 0;
        }

        HorizontalBox {
            spacing: 0px;
            vertical-stretch: 1;

            ChuziSidebar {
                compact: root.compact-shell;
                page: root.page;
                navigate(page) => { root.navigate(page); }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: ChuziTheme.content-background;

                HorizontalBox {
                    spacing: 0px;

                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;

                        VerticalBox {
                            padding: ChuziTheme.space-6;
                            padding-right: root.inspector-collapsed && root.inspector-open ? ChuziTheme.space-6 + 320px : ChuziTheme.space-6;
                            spacing: ChuziTheme.space-3;

                            if root.session-workspace-visible: ChuziSessionWorkspace {
                                host: root.session-workspace-host;
                                state: root.session-workspace-state;
                                status: root.session-workspace-status;
                                frame: root.session-workspace-frame;
                                dock => { root.session-workspace-dock(); }
                                float => { root.session-workspace-float(); }
                                hide => { root.session-workspace-hide(); }
                                stop => { root.session-workspace-stop(); }
                                vertical-stretch: 0;
                            }

                            HorizontalBox {
                                height: 48px;
                                spacing: ChuziTheme.space-2;
                                Text {
                                    text: "Sessions";
                                    color: ChuziTheme.text-primary;
                                    font-size: ChuziTheme.type-title;
                                    font-weight: 650;
                                    vertical-alignment: center;
                                    vertical-stretch: 1;
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                if root.inspector-collapsed: Button {
                                    text: root.inspector-open ? "Inspector open" : "Inspector";
                                    vertical-stretch: 0;
                                    clicked => { root.inspector-open = !root.inspector-open; }
                                }
                                Button {
                                    text: "Refresh";
                                    enabled: !root.busy;
                                    vertical-stretch: 0;
                                    clicked => { root.refresh-sessions(); }
                                }
                            }

                            if !root.core-ready: Rectangle {
                                background: ChuziTheme.surface-background;
                                border-color: ChuziTheme.separator;
                                border-width: 1px;
                                border-radius: ChuziTheme.radius-surface;
                                vertical-stretch: 0;
                                VerticalBox {
                                    padding: ChuziTheme.space-4;
                                    spacing: ChuziTheme.space-2;
                                    Text {
                                        text: root.core-status;
                                        color: ChuziTheme.text-primary;
                                        font-size: ChuziTheme.type-section;
                                        font-weight: 600;
                                        vertical-stretch: 0;
                                    }
                                    Text {
                                        text: root.core-details;
                                        color: ChuziTheme.text-secondary;
                                        font-size: ChuziTheme.type-secondary;
                                        wrap: word-wrap;
                                        vertical-stretch: 0;
                                    }
                                    HorizontalBox {
                                        height: ChuziTheme.control-height;
                                        spacing: ChuziTheme.space-2;
                                        if !root.core-status-known: Button {
                                            text: "Refresh Core";
                                            enabled: !root.busy;
                                            clicked => { root.refresh-core(); }
                                        }
                                        if root.core-status-known && !root.core-installed: Button {
                                            text: "Install Core";
                                            enabled: !root.busy;
                                            clicked => { root.install-core(); }
                                        }
                                        if root.core-status-known && root.core-installed: Button {
                                            text: "Start Core";
                                            enabled: !root.busy;
                                            clicked => { root.start-core(); }
                                        }
                                        Button {
                                            text: "Check status";
                                            enabled: !root.busy;
                                            clicked => { root.refresh-core(); }
                                        }
                                    }
                                }
                            }

                            Text {
                                text: "Requests from Core";
                                color: ChuziTheme.text-secondary;
                                font-size: ChuziTheme.type-secondary;
                                wrap: word-wrap;
                                vertical-stretch: 0;
                            }

                            if root.inspector-collapsed: VerticalBox {
                                spacing: ChuziTheme.space-1;
                                vertical-stretch: 0;
                                HorizontalBox {
                                    height: 38px;
                                    spacing: ChuziTheme.space-2;
                                    LineEdit {
                                        horizontal-stretch: 1;
                                        min-width: 132px;
                                        placeholder-text: "Search request or account";
                                        text <=> root.session-search;
                                        edited => { root.session-search-changed(self.text); }
                                    }
                                }
                                HorizontalBox {
                                    height: 32px;
                                    spacing: 4px;
                                    ChuziFilterChip { label: "All"; width: 48px; selected: root.session-filter == "all"; activated => { root.session-filter-changed("all"); } }
                                    ChuziFilterChip { label: "Running"; width: 78px; selected: root.session-filter == "running"; activated => { root.session-filter-changed("running"); } }
                                    ChuziFilterChip { label: "Queued"; width: 82px; selected: root.session-filter == "queued"; activated => { root.session-filter-changed("queued"); } }
                                    ChuziFilterChip { label: "Failed"; width: 64px; selected: root.session-filter == "failed"; activated => { root.session-filter-changed("failed"); } }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }
                            }
                            if !root.inspector-collapsed: HorizontalBox {
                                height: 38px;
                                spacing: 4px;
                                LineEdit {
                                    min-width: 132px;
                                    preferred-width: 188px;
                                    placeholder-text: "Search request or account";
                                    text <=> root.session-search;
                                    edited => { root.session-search-changed(self.text); }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                ChuziFilterChip { label: "All"; width: 48px; selected: root.session-filter == "all"; activated => { root.session-filter-changed("all"); } }
                                ChuziFilterChip { label: "Running"; width: 78px; selected: root.session-filter == "running"; activated => { root.session-filter-changed("running"); } }
                                ChuziFilterChip { label: "Queued"; width: 82px; selected: root.session-filter == "queued"; activated => { root.session-filter-changed("queued"); } }
                                ChuziFilterChip { label: "Failed"; width: 64px; selected: root.session-filter == "failed"; activated => { root.session-filter-changed("failed"); } }
                            }

                            FeedbackBar {
                                text: root.message == "Working..." ? "" : root.message;
                                kind: root.message-kind;
                                vertical-stretch: 0;
                            }

                            Text {
                                text: root.session-phase == "loading" ? "Updating request list…" :
                                    root.session-phase == "error" || root.session-phase == "unavailable" ? root.session-collection-message :
                                    root.session-has-more-requests ? "Showing loaded requests · more available" : "";
                                color: root.session-phase == "error" || root.session-phase == "unavailable" ? ChuziTheme.status-danger : ChuziTheme.text-secondary;
                                font-size: ChuziTheme.type-caption;
                                wrap: word-wrap;
                                vertical-stretch: 0;
                            }

                            FocusScope {
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                focus-on-click: true;
                                key-pressed(event) => {
                                    if event.text == Key.UpArrow { root.move-session-selection("up"); accept }
                                    else if event.text == Key.DownArrow { root.move-session-selection("down"); accept }
                                    else if event.text == Key.Home { root.move-session-selection("home"); accept }
                                    else if event.text == Key.End { root.move-session-selection("end"); accept }
                                    else if event.text == Key.Return && root.session-inspector-selected && root.session-inspector-primary-action != "none" {
                                        if root.session-inspector-primary-action == "cancel" {
                                            root.cancel-confirmation-request-id = root.session-inspector-request-id;
                                            root.cancel-confirmation-account-label = "";
                                            root.cancel-confirmation-visible = true;
                                        } else {
                                            root.session-primary-action(root.session-inspector-request-id, root.session-inspector-primary-action);
                                        }
                                        accept
                                    } else if event.text == Key.Escape && root.inspector-open {
                                        root.inspector-open = false;
                                        accept
                                    } else { reject }
                                }

                                ScrollView {
                                    horizontal-stretch: 1;
                                    vertical-stretch: 1;

                                    VerticalBox {
                                        spacing: 1px;
                                        if root.session-rows.length == 0 && root.session-phase == "empty": Rectangle {
                                            height: 176px;
                                            background: transparent;
                                            VerticalBox {
                                                padding-top: ChuziTheme.space-7;
                                                spacing: ChuziTheme.space-2;
                                                Text { text: "No requests yet"; color: ChuziTheme.text-primary; font-size: ChuziTheme.type-section; font-weight: 600; vertical-stretch: 0; }
                                                Text { text: "Requests appear after one is submitted for an authorized account."; color: ChuziTheme.text-secondary; font-size: ChuziTheme.type-secondary; wrap: word-wrap; vertical-stretch: 0; }
                                            }
                                        }
                                        if root.session-rows.length == 0 && root.session-phase == "loading": Rectangle {
                                            height: 120px;
                                            background: transparent;
                                            Text { text: "Loading requests from Core…"; color: ChuziTheme.text-secondary; font-size: ChuziTheme.type-body; vertical-alignment: center; x: ChuziTheme.space-3; width: parent.width - 24px; height: parent.height; }
                                        }
                                        if root.session-rows.length == 0 && (root.session-phase == "error" || root.session-phase == "unavailable"): Rectangle {
                                            height: 156px;
                                            background: ChuziTheme.surface-background;
                                            border-color: ChuziTheme.separator;
                                            border-width: 1px;
                                            border-radius: ChuziTheme.radius-surface;
                                            VerticalBox {
                                                padding: ChuziTheme.space-5;
                                                spacing: ChuziTheme.space-2;
                                                Text { text: "Requests could not be loaded"; color: ChuziTheme.text-primary; font-size: ChuziTheme.type-section; font-weight: 600; vertical-stretch: 0; }
                                                Text { text: root.session-collection-message; color: ChuziTheme.text-secondary; font-size: ChuziTheme.type-secondary; wrap: word-wrap; vertical-stretch: 0; }
                                                Button { text: "Try again"; enabled: !root.busy; vertical-stretch: 0; clicked => { root.refresh-sessions(); } }
                                            }
                                        }
                                        if root.session-rows.length == 0 && root.session-phase == "ready": Rectangle {
                                            height: 120px;
                                            background: transparent;
                                            Text { text: "No loaded requests match this search and filter."; color: ChuziTheme.text-secondary; font-size: ChuziTheme.type-body; vertical-alignment: center; x: ChuziTheme.space-3; width: parent.width - 24px; height: parent.height; }
                                        }
                                        for row[index] in root.session-rows: ChuziSessionRow {
                                            item: row;
                                            busy: root.busy;
                                            show-action: !root.inspector-collapsed;
                                            focus-visible: root.snapshot-focus && index == 0;
                                            selected(request-id) => {
                                                root.select-session(request-id);
                                                if root.inspector-collapsed { root.inspector-open = true; }
                                            }
                                            action(request-id, action) => {
                                                root.select-session(request-id);
                                                if root.inspector-collapsed { root.inspector-open = true; }
                                                if action == "cancel" {
                                                    root.cancel-confirmation-request-id = request-id;
                                                    root.cancel-confirmation-account-label = "";
                                                    root.cancel-confirmation-visible = true;
                                                } else {
                                                    root.session-primary-action(request-id, action);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.session-has-more-requests: Button {
                                text: "Load older requests";
                                enabled: !root.busy;
                                vertical-stretch: 0;
                                clicked => { root.load-more-sessions(); }
                            }
                        }
                    }

                    if !root.inspector-collapsed: ChuziSessionInspector {
                        selected: root.session-inspector-selected;
                        request-id: root.session-inspector-request-id;
                        account-label: root.session-inspector-account-label;
                        status-label: root.session-inspector-status-label;
                        attempt-label: root.session-inspector-attempt-label;
                        created-at: root.session-inspector-created-at;
                        updated-at: root.session-inspector-updated-at;
                        failure-label: root.session-inspector-failure-label;
                        primary-action: root.session-inspector-primary-action;
                        primary-label: root.session-inspector-primary-label;
                        has-more-action: root.session-inspector-has-more-action;
                        menu-open: root.session-inspector-menu-open;
                        menu-visible: root.session-inspector-menu-open;
                        has-more-requests: root.session-has-more-requests;
                        collection-message: root.session-collection-message;
                        browser-view: root.session-browser-view;
                        browser-view-loaded: root.session-browser-view-loaded;
                        browser-view-status: root.session-browser-view-status;
                        busy: root.busy;
                        primary(request-id, action) => {
                            if action == "cancel" {
                                root.cancel-confirmation-request-id = request-id;
                                root.cancel-confirmation-account-label = "";
                                root.cancel-confirmation-visible = true;
                            } else {
                                root.session-primary-action(request-id, action);
                            }
                        }
                        more-action(request-id, action) => { root.session-more-action(request-id, action); }
                        load-more => { root.load-more-sessions(); }
                        vertical-stretch: 1;
                    }
                }
            }
        }
    }

    if root.page == "settings": Rectangle {
        x: root.compact-shell ? ChuziTheme.sidebar-compact-width : ChuziTheme.sidebar-width;
        y: ChuziTheme.titlebar-height;
        width: root.width - self.x;
        height: root.height - self.y;
        background: ChuziTheme.content-background;
        z: 20;

        ScrollView {
            VerticalBox {
                padding: ChuziTheme.space-6;
                spacing: ChuziTheme.space-3;

                HorizontalBox {
                    height: 48px;
                    spacing: ChuziTheme.space-2;
                    Text {
                        text: "Settings";
                        color: ChuziTheme.text-primary;
                        font-size: ChuziTheme.type-title;
                        font-weight: 650;
                        vertical-alignment: center;
                        vertical-stretch: 1;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button {
                        text: root.settings-phase == "saving" ? "Saving…" : "Save changes";
                        enabled: !root.busy && root.settings-phase != "saving";
                        vertical-stretch: 0;
                        clicked => { root.save-settings(); }
                    }
                }

                Text {
                    text: "A calm control surface for appearance, Core lifecycle, updates, and startup behavior.";
                    color: ChuziTheme.text-secondary;
                    font-size: ChuziTheme.type-secondary;
                    wrap: word-wrap;
                    vertical-stretch: 0;
                }

                FeedbackBar {
                    text: root.message == "Working..." ? "" : root.message;
                    kind: root.message-kind;
                    vertical-stretch: 0;
                }

                Rectangle {
                    background: ChuziTheme.surface-background;
                    border-color: ChuziTheme.separator;
                    border-width: 1px;
                    border-radius: ChuziTheme.radius-surface;
                    vertical-stretch: 0;
                    VerticalBox {
                        padding: ChuziTheme.space-5;
                        spacing: ChuziTheme.space-3;
                        HorizontalBox {
                            height: 34px;
                            spacing: ChuziTheme.space-2;
                            Text { text: "Job pools"; color: ChuziTheme.text-primary; font-size: ChuziTheme.type-section; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                            Button { text: root.job-pool-phase == "loading" ? "Refreshing…" : "Refresh"; enabled: !root.busy; clicked => { root.refresh-job-pools(); } }
                        }
                        Text { text: "Capacity, environment readiness, reconcile state, and safe lifecycle controls."; color: ChuziTheme.text-secondary; font-size: ChuziTheme.type-secondary; wrap: word-wrap; vertical-stretch: 0; }
                        if root.job-pool-rows.length == 0: Text { text: root.job-pool-phase == "loading" ? "Loading pools…" : "No job pools are configured."; color: ChuziTheme.text-tertiary; font-size: ChuziTheme.type-body; vertical-stretch: 0; }
                        for pool in root.job-pool-rows: ChuziJobPoolCard {
                            item: pool;
                            busy: root.busy || root.operation-phase == "submitting" || root.operation-phase == "polling";
                            selected(pool-id) => {
                                root.job-pool-edit-id = pool.pool_id;
                                root.job-pool-edit-environment-id = pool.environment_id;
                                root.job-pool-edit-environment-version = pool.environment_version;
                                root.job-pool-edit-desired = pool.desired_slots;
                                root.job-pool-edit-max = pool.max_concurrency;
                            }
                            action(value, kind) => {
                                if kind == "operation" {
                                    root.job-pool-operation(value);
                                } else {
                                    root.pending-operation = kind;
                                    root.pending-pool-id = value;
                                    root.operation-confirmation-title = kind == "drain" ? "Drain this pool?" : kind == "delete" ? "Delete this pool?" : "Resume this pool?";
                                    root.operation-confirmation-message = kind == "drain" ? "New work will stop while leased slots finish safely." : kind == "delete" ? "New work will stop. The pool and its managed slots will be removed after leases and resources finish cleanup." : "The pool will accept new work after reconciliation.";
                                    root.operation-confirmation-visible = true;
                                }
                            }
                            vertical-stretch: 0;
                        }
                        if root.operation-phase != "idle": Rectangle {
                            background: root.operation-phase == "failed" || root.operation-phase == "stale revision" ? ChuziTheme.status-danger.with-alpha(0.10) : ChuziTheme.accent-soft;
                            border-color: root.operation-phase == "failed" || root.operation-phase == "stale revision" ? ChuziTheme.status-danger : ChuziTheme.accent.with-alpha(0.35);
                            border-width: 1px;
                            border-radius: ChuziTheme.radius-small;
                            height: 92px;
                            VerticalBox {
                                padding: ChuziTheme.space-3;
                                spacing: 2px;
                                HorizontalBox { spacing: ChuziTheme.space-2; Text { text: "Operation " + root.operation-id; color: ChuziTheme.text-primary; font-size: ChuziTheme.type-caption; font-weight: 600; horizontal-stretch: 1; overflow: elide; } Text { text: root.operation-phase; color: ChuziTheme.text-secondary; font-size: ChuziTheme.type-caption; } }
                                Text { text: root.operation-state + "  ·  " + root.operation-detail; color: ChuziTheme.text-secondary; font-size: ChuziTheme.type-caption; wrap: word-wrap; vertical-stretch: 1; }
                                if root.operation-phase == "failed" || root.operation-phase == "stale revision" || root.operation-phase == "service restarted": Button { text: "Refresh projection"; clicked => { root.refresh-job-pools(); } }
                            }
                        }
                    }
                }

                Rectangle {
                    background: ChuziTheme.surface-background;
                    border-color: ChuziTheme.separator;
                    border-width: 1px;
                    border-radius: ChuziTheme.radius-surface;
                    vertical-stretch: 0;
                    VerticalBox {
                        padding: ChuziTheme.space-5;
                        spacing: ChuziTheme.space-2;
                        Text { text: "Apply or scale a pool"; color: ChuziTheme.text-primary; font-size: ChuziTheme.type-section; font-weight: 600; vertical-stretch: 0; }
                        Text { text: "Changes use the current config revision and an idempotency key generated by the launcher façade."; color: ChuziTheme.text-secondary; font-size: ChuziTheme.type-caption; wrap: word-wrap; vertical-stretch: 0; }
                        HorizontalBox { spacing: ChuziTheme.space-2; height: 34px; LineEdit { placeholder-text: "Pool ID"; text <=> root.job-pool-edit-id; horizontal-stretch: 1; } LineEdit { placeholder-text: "Environment ID"; text <=> root.job-pool-edit-environment-id; horizontal-stretch: 1; } }
                        HorizontalBox { spacing: ChuziTheme.space-2; height: 34px; LineEdit { placeholder-text: "Environment version"; text <=> root.job-pool-edit-environment-version; horizontal-stretch: 1; } SpinBox { value <=> root.job-pool-edit-desired; minimum: 0; maximum: 10000; } Text { text: "desired"; color: ChuziTheme.text-secondary; vertical-alignment: center; } SpinBox { value <=> root.job-pool-edit-max; minimum: 0; maximum: 10000; } Text { text: "max"; color: ChuziTheme.text-secondary; vertical-alignment: center; } }
                        HorizontalBox { spacing: ChuziTheme.space-2; height: ChuziTheme.control-height; Button { text: "Apply configuration"; enabled: !root.busy; clicked => { root.pending-operation = "apply"; root.pending-pool-id = root.job-pool-edit-id; root.operation-confirmation-title = "Apply pool configuration?"; root.operation-confirmation-message = "Core will validate the revision and reconcile capacity. Environment changes require a fresh trusted readiness gate."; root.operation-confirmation-visible = true; } } Button { text: "Scale only"; enabled: !root.busy; clicked => { root.pending-operation = "scale"; root.pending-pool-id = root.job-pool-edit-id; root.operation-confirmation-title = "Scale this pool?"; root.operation-confirmation-message = "The requested capacity will be reconciled against the current environment."; root.operation-confirmation-visible = true; } } }
                    }
                }

                Rectangle {
                    background: ChuziTheme.surface-background;
                    border-color: ChuziTheme.separator;
                    border-width: 1px;
                    border-radius: ChuziTheme.radius-surface;
                    vertical-stretch: 0;
                    VerticalBox {
                        padding: ChuziTheme.space-5;
                        spacing: ChuziTheme.space-3;
                        Text { text: "Environments"; color: ChuziTheme.text-primary; font-size: ChuziTheme.type-section; font-weight: 600; vertical-stretch: 0; }
                        Text { text: "Lifecycle actions accept only opaque service-owned package references. Paths, commands, and runtime handles are not accepted."; color: ChuziTheme.text-secondary; font-size: ChuziTheme.type-caption; wrap: word-wrap; vertical-stretch: 0; }
                        HorizontalBox { spacing: ChuziTheme.space-2; height: 34px; LineEdit { placeholder-text: "Environment ID"; text <=> root.operation-environment-id; horizontal-stretch: 1; } LineEdit { placeholder-text: "Version"; text <=> root.operation-environment-version; horizontal-stretch: 1; } LineEdit { placeholder-text: "Opaque package reference"; text <=> root.package-reference; horizontal-stretch: 1; } }
                        HorizontalBox { spacing: ChuziTheme.space-1; height: 34px; for op in ["install", "upgrade", "verify", "trust", "enable", "disable", "health", "rollback"]: Button { text: op; enabled: !root.busy; clicked => { root.pending-operation = "environment:" + op; root.pending-environment-id = root.operation-environment-id; root.pending-environment-version = root.operation-environment-version; root.operation-confirmation-title = op == "disable" || op == "rollback" ? "Confirm environment " + op + "?" : "Run environment " + op + "?"; root.operation-confirmation-message = "The service will apply this lifecycle gate and report a redacted operation status."; root.operation-confirmation-visible = true; } } }
                        if root.environment-rows.length == 0: Text { text: root.environment-operation-phase == "loading" ? "Loading environments…" : "No environment records are available."; color: ChuziTheme.text-tertiary; font-size: ChuziTheme.type-body; vertical-stretch: 0; }
                        for environment in root.environment-rows: ChuziEnvironmentCard { item: environment; busy: root.busy; action(environment-id, version, op, generation) => { root.pending-operation = "environment:" + op; root.pending-environment-id = environment-id; root.pending-environment-version = version; root.pending-environment-generation = generation; root.operation-confirmation-title = op == "disable" || op == "rollback" ? "Confirm environment " + op + "?" : "Run environment " + op + "?"; root.operation-confirmation-message = "The service will apply this lifecycle gate and report a redacted operation status."; root.operation-confirmation-visible = true; } vertical-stretch: 0; }
                    }
                }

                Rectangle {
                    background: ChuziTheme.surface-background;
                    border-color: ChuziTheme.separator;
                    border-width: 1px;
                    border-radius: ChuziTheme.radius-surface;
                    vertical-stretch: 0;
                    VerticalBox {
                        padding: ChuziTheme.space-5;
                        spacing: ChuziTheme.space-3;
                        Text { text: "Appearance"; color: ChuziTheme.text-primary; font-size: ChuziTheme.type-section; font-weight: 600; vertical-stretch: 0; }
                        Text { text: "Choose how Chuzi follows your desktop without changing Core behavior."; color: ChuziTheme.text-secondary; font-size: ChuziTheme.type-secondary; wrap: word-wrap; vertical-stretch: 0; }
                        ComboBox {
                            model: ["System default", "Light", "Dark"];
                            current-index: root.theme == "light" ? 1 : root.theme == "dark" ? 2 : 0;
                            selected => {
                                root.theme = self.current-index == 1 ? "light" : self.current-index == 2 ? "dark" : "system";
                                root.theme-changed(root.theme);
                            }
                            vertical-stretch: 0;
                        }
                    }
                }

                Rectangle {
                    background: ChuziTheme.surface-background;
                    border-color: ChuziTheme.separator;
                    border-width: 1px;
                    border-radius: ChuziTheme.radius-surface;
                    vertical-stretch: 0;
                    VerticalBox {
                        padding: ChuziTheme.space-5;
                        spacing: ChuziTheme.space-2;
                        Text { text: "Core service"; color: ChuziTheme.text-primary; font-size: ChuziTheme.type-section; font-weight: 600; vertical-stretch: 0; }
                        Text { text: root.core-status; color: root.core-ready ? ChuziTheme.status-positive : ChuziTheme.status-warning; font-size: ChuziTheme.type-body; font-weight: 600; vertical-stretch: 0; }
                        Text { text: "Core data is managed in the application data location."; color: ChuziTheme.text-secondary; font-size: ChuziTheme.type-secondary; wrap: word-wrap; vertical-stretch: 0; }
                        CheckBox { text: "Start Core automatically when Chuzi launches"; checked: root.start-core-on-launch; toggled => { root.start-core-on-launch = self.checked; } }
                        HorizontalBox {
                            spacing: ChuziTheme.space-2;
                            height: ChuziTheme.control-height;
                            vertical-stretch: 0;
                            if !root.core-installed: Button { text: "Install Core"; enabled: !root.busy; clicked => { root.install-core(); } }
                            if root.core-installed && !root.core-ready: Button { text: "Start Core"; enabled: !root.busy; clicked => { root.start-core(); } }
                            if root.core-ready: Button { text: "Stop Core"; enabled: !root.busy; clicked => { root.stop-core(); } }
                            Button { text: "Refresh status"; enabled: !root.busy; clicked => { root.refresh-core(); } }
                        }
                    }
                }

                Rectangle {
                    background: ChuziTheme.surface-background;
                    border-color: ChuziTheme.separator;
                    border-width: 1px;
                    border-radius: ChuziTheme.radius-surface;
                    vertical-stretch: 0;
                    VerticalBox {
                        padding: ChuziTheme.space-5;
                        spacing: ChuziTheme.space-2;
                        Text { text: "Updates"; color: ChuziTheme.text-primary; font-size: ChuziTheme.type-section; font-weight: 600; vertical-stretch: 0; }
                        Text { text: "Automatic checks never change the selected channel without your confirmation."; color: ChuziTheme.text-secondary; font-size: ChuziTheme.type-secondary; wrap: word-wrap; vertical-stretch: 0; }
                        CheckBox { text: "Check for updates automatically"; checked: root.auto-check-updates; toggled => { root.auto-check-updates = self.checked; } }
                        CheckBox { text: "Repair missing files automatically"; checked: root.auto-repair; toggled => { root.auto-repair = self.checked; } }
                        HorizontalBox {
                            spacing: ChuziTheme.space-3;
                            height: ChuziTheme.control-height;
                            vertical-stretch: 0;
                            Text { text: "Channel"; color: ChuziTheme.text-secondary; vertical-alignment: center; vertical-stretch: 1; }
                            ComboBox {
                                model: ["Nightly", "Test", "Stable"];
                                current-index: root.update-channel == "stable" ? 2 : root.update-channel == "test" ? 1 : 0;
                                selected => { root.update-channel = self.current-index == 2 ? "stable" : self.current-index == 1 ? "test" : "nightly"; }
                                vertical-stretch: 0;
                            }
                            Text { text: "Every"; color: ChuziTheme.text-secondary; vertical-alignment: center; vertical-stretch: 1; }
                            SpinBox { value <=> root.update-interval; minimum: 5; maximum: 10080; vertical-stretch: 0; }
                            Text { text: "minutes"; color: ChuziTheme.text-secondary; vertical-alignment: center; vertical-stretch: 1; }
                        }
                    }
                }

                Rectangle {
                    background: ChuziTheme.surface-background;
                    border-color: ChuziTheme.separator;
                    border-width: 1px;
                    border-radius: ChuziTheme.radius-surface;
                    vertical-stretch: 0;
                    VerticalBox {
                        padding: ChuziTheme.space-5;
                        spacing: ChuziTheme.space-2;
                        Text { text: "Startup"; color: ChuziTheme.text-primary; font-size: ChuziTheme.type-section; font-weight: 600; vertical-stretch: 0; }
                        Text { text: "Control when Chuzi stays available on this device."; color: ChuziTheme.text-secondary; font-size: ChuziTheme.type-secondary; wrap: word-wrap; vertical-stretch: 0; }
                        CheckBox { text: "Launch Chuzi when I sign in"; checked: root.launch-on-login; toggled => { root.launch-on-login = self.checked; } }
                        CheckBox { text: "Keep Chuzi running when the window closes"; checked: root.close-to-tray; toggled => { root.close-to-tray = self.checked; } }
                    }
                }

                Rectangle {
                    background: ChuziTheme.surface-background;
                    border-color: ChuziTheme.separator;
                    border-width: 1px;
                    border-radius: ChuziTheme.radius-surface;
                    vertical-stretch: 0;
                    VerticalBox {
                        padding: ChuziTheme.space-5;
                        spacing: ChuziTheme.space-2;
                        Text { text: "Diagnostics and privacy"; color: ChuziTheme.text-primary; font-size: ChuziTheme.type-section; font-weight: 600; vertical-stretch: 0; }
                        Text { text: "Local diagnostic files are redacted. They exclude passwords, tokens, cookies, page content, RDP credentials, and raw filesystem paths."; color: ChuziTheme.text-secondary; font-size: ChuziTheme.type-secondary; wrap: word-wrap; vertical-stretch: 0; }
                        Text { text: "No network request is made when you save a local diagnostic file."; color: ChuziTheme.text-tertiary; font-size: ChuziTheme.type-caption; wrap: word-wrap; vertical-stretch: 0; }
                        HorizontalBox {
                            height: ChuziTheme.control-height;
                            spacing: ChuziTheme.space-2;
                            vertical-stretch: 0;
                            Button { text: "Save local diagnostics"; enabled: !root.busy; clicked => { root.diagnostic-open(); } }
                        }
                    }
                }
            }
        }
    }

    if root.page == "sessions" && root.inspector-collapsed && root.inspector-open: Rectangle {
        x: 0px;
        y: root.compact-inspector-top;
        width: root.width;
        height: root.height - root.compact-inspector-top;
        background: ChuziTheme.overlay-scrim;
        z: 59;
        TouchArea { clicked => { root.inspector-open = false; } }
    }

    if root.page == "sessions" && root.inspector-collapsed && root.inspector-open: ChuziSessionInspector {
        x: root.width - self.width;
        y: root.compact-inspector-top;
        width: root.width < 360px ? root.width : 320px;
        height: root.height - root.compact-inspector-top;
        z: 60;
        compact: true;
        selected: root.session-inspector-selected;
        request-id: root.session-inspector-request-id;
        account-label: root.session-inspector-account-label;
        status-label: root.session-inspector-status-label;
        attempt-label: root.session-inspector-attempt-label;
        created-at: root.session-inspector-created-at;
        updated-at: root.session-inspector-updated-at;
        failure-label: root.session-inspector-failure-label;
        primary-action: root.session-inspector-primary-action;
        primary-label: root.session-inspector-primary-label;
        has-more-action: root.session-inspector-has-more-action;
        menu-open: root.session-inspector-menu-open;
        menu-visible: root.session-inspector-menu-open;
        has-more-requests: root.session-has-more-requests;
        collection-message: root.session-collection-message;
        browser-view: root.session-browser-view;
        browser-view-loaded: root.session-browser-view-loaded;
        browser-view-status: root.session-browser-view-status;
        busy: root.busy;
        primary(request-id, action) => {
            if action == "cancel" {
                root.cancel-confirmation-request-id = request-id;
                root.cancel-confirmation-account-label = "";
                root.cancel-confirmation-visible = true;
            } else {
                root.session-primary-action(request-id, action);
            }
        }
        more-action(request-id, action) => { root.session-more-action(request-id, action); }
        close => { root.inspector-open = false; }
        load-more => { root.load-more-sessions(); }
    }

    if root.operation-confirmation-visible: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: ChuziTheme.overlay-scrim;
        z: 80;
        Rectangle {
            width: root.width < 560px ? root.width - 40px : 500px;
            height: 246px;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            background: ChuziTheme.elevated-background;
            border-color: ChuziTheme.separator;
            border-width: 1px;
            border-radius: ChuziTheme.radius-surface;
            VerticalBox {
                padding: ChuziTheme.space-6;
                spacing: ChuziTheme.space-3;
                Text { text: root.operation-confirmation-title; color: ChuziTheme.text-primary; font-size: ChuziTheme.type-title; font-weight: 650; vertical-stretch: 0; }
                Text { text: root.operation-confirmation-message; color: ChuziTheme.text-secondary; font-size: ChuziTheme.type-body; wrap: word-wrap; vertical-stretch: 1; }
                HorizontalBox { spacing: ChuziTheme.space-2; height: ChuziTheme.control-height; Rectangle { horizontal-stretch: 1; background: transparent; } Button { text: "Keep editing"; clicked => { root.operation-cancelled(); } } Button { text: "Confirm"; clicked => { root.operation-confirmed(); } } }
            }
        }
    }

    if root.cancel-confirmation-visible: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: ChuziTheme.overlay-scrim;
        z: 90;

        Rectangle {
            width: root.width < 560px ? root.width - 40px : 480px;
            height: 224px;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            background: ChuziTheme.elevated-background;
            border-color: ChuziTheme.separator;
            border-width: 1px;
            border-radius: ChuziTheme.radius-surface;

            sheet-focus := FocusScope {
                width: parent.width;
                height: parent.height;
                focus-on-click: true;
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.cancel-confirmation-visible = false;
                        accept
                    } else {
                        reject
                    }
                }

                VerticalBox {
                    padding: ChuziTheme.space-6;
                    spacing: ChuziTheme.space-2;
                    Text {
                        text: "Cancel queued request?";
                        color: ChuziTheme.text-primary;
                        font-size: ChuziTheme.type-title;
                        font-weight: 650;
                        vertical-stretch: 0;
                    }
                    Text {
                        text: root.cancel-confirmation-account-label == "" ?
                            "This request will stop before it starts." :
                            "This request for " + root.cancel-confirmation-account-label + " will stop before it starts.";
                        color: ChuziTheme.text-secondary;
                        font-size: ChuziTheme.type-body;
                        wrap: word-wrap;
                        vertical-stretch: 1;
                    }
                    HorizontalBox {
                        spacing: ChuziTheme.space-2;
                        height: ChuziTheme.control-height;
                        vertical-stretch: 0;
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        ChuziActionButton {
                            label: "Keep request";
                            width: 112px;
                            escape-enabled: true;
                            pressed => { root.cancel-confirmation-visible = false; }
                            escape-pressed => { root.cancel-confirmation-visible = false; }
                        }
                        ChuziActionButton {
                            label: "Cancel request";
                            width: 124px;
                            destructive: true;
                            escape-enabled: true;
                            pressed => {
                                root.cancel-confirmation-visible = false;
                                root.session-cancel-confirmed(root.cancel-confirmation-request-id);
                            }
                            escape-pressed => { root.cancel-confirmation-visible = false; }
                        }
                    }
                }
            }
        }
    }

    if root.diagnostic-consent-visible: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #00000099;
        z: 100;

        Rectangle {
            width: root.width < 620px ? root.width - 48px : 560px;
            height: 300px;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            background: Palette.background;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 10px;

            VerticalBox {
                padding: 24px;
                spacing: 12px;
                Text { text: "保存本地诊断文件"; color: Palette.foreground; font-size: 22px; font-weight: 700; vertical-stretch: 0; }
                Text { text: root.diagnostic-consent-summary; color: Palette.foreground; wrap: word-wrap; vertical-stretch: 0; }
                Text { text: "文件只包含分类错误、最近的脱敏运行事件和必要的版本/平台信息。不会收集密码、Token、Cookie、页面内容、RDP 凭据或原始路径。"; color: Palette.alternate-foreground; wrap: word-wrap; vertical-stretch: 1; }
                Text { text: root.diagnostic-submitting ? "正在生成本地诊断文件…" : "保存动作只写入本机文件，不会发送到远程服务。"; color: Palette.alternate-foreground; font-size: 12px; wrap: word-wrap; vertical-stretch: 0; }
                HorizontalBox {
                    spacing: 10px;
                    height: 40px;
                    vertical-stretch: 0;
                    Button { text: "关闭"; enabled: !root.diagnostic-submitting; clicked => { root.diagnostic-dismiss(); } }
                    Button { text: "保存诊断文件"; enabled: !root.diagnostic-submitting; clicked => { root.diagnostic-save(); } }
                }
            }
        }
    }
}

component RdpBarButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <length> button-width: 80px;
    in property <bool> enabled: true;
    callback pressed();

    width: root.button-width;
    height: 32px;
    background: transparent;
    opacity: root.enabled ? 1.0 : 0.45;

    Text {
        text: root.icon;
        color: #f4f4f4;
        font-size: 15px;
        x: 7px;
        y: 0px;
        width: 18px;
        height: 32px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        text: root.label;
        color: #f4f4f4;
        font-size: 12px;
        x: 29px;
        y: 0px;
        width: root.button-width - 37px;
        height: 32px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    TouchArea {
        enabled: root.enabled;
        clicked => { root.pressed(); }
    }
}

component RdpIconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> active: false;
    callback pressed();

    width: 40px;
    height: 32px;
    background: transparent;

    Text {
        text: root.icon;
        color: root.active ? #60b9f4 : #f4f4f4;
        font-size: 17px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    TouchArea { clicked => { root.pressed(); } }
}

component WindowChromeButton inherits Rectangle {
    in property <string> icon;
    in property <color> hover-color: #2d2d2d;
    in property <color> pressed-color: #3a3a3a;
    callback pressed();

    width: 46px;
    height: 32px;
    background: touch-area.pressed ? root.pressed-color : touch-area.has-hover ? root.hover-color : transparent;

    Text {
        text: root.icon;
        color: #f4f4f4;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    touch-area := TouchArea {
        clicked => { root.pressed(); }
    }
}

export component DesktopRdpWindow inherits Window {
    title: "RDP 连接";
    min-width: 415px;
    min-height: 90px;
    preferred-width: 1280px;
    preferred-height: 752px;
    no-frame: true;
    resize-border-width: 1px;
    always-on-top: root.topmost;

    in-out property <string> host: "localhost";
    in-out property <string> state: "not-started";
    in-out property <string> status: "";
    in-out property <image> frame;
    in-out property <bool> perf-hud-visible: false;
    in-out property <string> perf-hud-text: "";
    in-out property <bool> mouse-game-mode: false;
    in-out property <bool> audio-enabled: true;
    in-out property <bool> topmost: false;
    in-out property <bool> show-control-menu: false;
    in-out property <bool> notification-visible: false;
    in-out property <bool> small-window: false;
    in-out property <bool> keep-aspect-ratio: true;

    property <bool> connected: root.state == "connected";
    property <color> state-color: root.state == "connected" ? #32cd32 : root.state == "closing" ? #ffb900 : root.state == "connecting" ? #1e90ff : #e55353;
    property <string> state-title: root.state == "connected" ? "RDP 已连接" : root.state == "connecting" ? "正在连接 RDP" : root.state == "started" ? "RDP 已启动，等待连接" : root.state == "closing" ? "正在关闭 RDP" : root.state == "failed" ? "RDP 连接失败" : "RDP 尚未连接";
    property <string> state-description: root.state == "connected" ? "RDP 画面已接入 FreeRDP framebuffer。" : root.state == "connecting" ? "正在创建 RDP 连接，请稍候。" : root.state == "started" ? "RDP 会话仍在运行，点击“连接”可重新建立连接。" : root.state == "closing" ? "正在断开 RDP 并释放连接资源。" : root.state == "failed" ? "FreeRDP 无法建立连接，请检查目标地址和凭据。" : "点击“连接”，建立到目标桌面的 RDP 连接。";
    property <string> rdp-status: root.state == "connected" ? "RDP 已连接" : root.state == "connecting" ? "RDP 正在连接" : root.state == "closing" ? "正在断开 RDP" : root.state == "failed" ? "RDP 连接失败" : "RDP 未连接";
    property <string> session-status: root.state == "not-started" ? "RDP 会话未创建" : root.state == "closing" ? "RDP 会话正在释放" : root.state == "failed" ? "RDP 会话未建立" : "RDP 会话已创建";
    property <string> detail-status: root.status != "" ? root.status : root.state == "connected" ? "远程桌面画面区域已准备好。" : "FreeRDP 会话尚未返回远程桌面画面。";
    property <bool> compact-layout: root.width < 620px || root.height < 420px;

    callback hide-window();

    background: #141414;

    Rectangle {
        background: #000000;

        VerticalBox {
            spacing: 0px;

            Rectangle {
                height: 32px;
                    background: #141414;
                vertical-stretch: 0;

                WindowMoveArea {
                    width: parent.width;
                    height: parent.height;
                }

                Rectangle {
                    x: 10px;
                    y: 7px;
                    width: 16px;
                    height: 12px;
                    border-radius: 3px;
                    background: #202a3a;
                    border-color: #60b9f4;
                    border-width: 1px;
                }
                Rectangle { x: 16px; y: 19px; width: 4px; height: 3px; background: #60b9f4; }
                Rectangle { x: 13px; y: 22px; width: 10px; height: 1px; background: #60b9f4; }
                Rectangle { x: 39px; y: 12px; width: 9px; height: 9px; border-radius: 5px; background: root.state-color; }
                Text { x: 56px; y: 0px; width: root.width - 360px; height: 32px; text: "RDP 连接"; color: #f4f4f4; font-size: 12px; vertical-alignment: center; overflow: elide; }

                RdpBarButton {
                    x: root.width - 718px;
                    y: 0px;
                    label: "连接";
                    icon: "▶";
                    button-width: 80px;
                    visible: root.width >= 760px;
                    pressed => { root.state = "connecting"; root.show-control-menu = false; }
                }
                RdpBarButton {
                    x: root.width - 638px;
                    y: 0px;
                    label: "隐藏";
                    icon: "◌";
                    button-width: 80px;
                    visible: root.width >= 680px;
                    pressed => { root.hide-window(); }
                }
                RdpBarButton {
                    x: root.width - 558px;
                    y: 0px;
                    label: "切换窗口";
                    icon: "⇄";
                    button-width: 110px;
                    visible: root.width >= 570px;
                    pressed => { root.state = root.state == "connected" ? "started" : "connected"; }
                }
                RdpBarButton {
                    x: root.width - 448px;
                    y: 0px;
                    label: root.mouse-game-mode ? "游戏鼠标" : "普通鼠标";
                    icon: root.mouse-game-mode ? "⌖" : "⌁";
                    button-width: 110px;
                    visible: root.width >= 470px;
                    pressed => { root.mouse-game-mode = !root.mouse-game-mode; }
                }
                RdpBarButton {
                    x: root.width - 338px;
                    y: 0px;
                    label: "连接设置";
                    icon: "▦";
                    button-width: 120px;
                    pressed => { root.show-control-menu = !root.show-control-menu; }
                }
                RdpIconButton {
                    x: root.width - 218px;
                    y: 0px;
                    icon: root.audio-enabled ? "◖" : "◗";
                    pressed => { root.audio-enabled = !root.audio-enabled; }
                }
                RdpIconButton {
                    x: root.width - 178px;
                    y: 0px;
                    icon: root.topmost ? "◆" : "◇";
                    active: root.topmost;
                    pressed => { root.topmost = !root.topmost; }
                }

                WindowChromeButton {
                    x: root.width - 138px;
                    y: 0px;
                    icon: "—";
                    pressed => { root.minimized = true; }
                }
                WindowChromeButton {
                    x: root.width - 92px;
                    y: 0px;
                    icon: root.maximized ? "❐" : "□";
                    pressed => { root.maximized = !root.maximized; }
                }
                WindowChromeButton {
                    x: root.width - 46px;
                    y: 0px;
                    icon: "×";
                    hover-color: #c42b1c;
                    pressed-color: #a5261a;
                    pressed => { root.close(); }
                }
            }

            Rectangle {
                background: #000000;
                vertical-stretch: 1;

                if root.state == "connected": Rectangle {
                    background: #000000;

                    rdp-focus := FocusScope {
                        width: parent.width;
                        height: parent.height;
                        focus-on-click: true;
                        focus-gained => { root.rdp-focus-event("gained"); }
                        focus-lost => {
                            root.rdp-focus-event("lost");
                            root.rdp-key-event("release-all", "", false);
                        }
                        key-pressed(event) => {
                            root.rdp-key-event("down", event.text, event.repeat);
                            accept
                        }
                        key-released(event) => {
                            root.rdp-key-event("up", event.text, false);
                            accept
                        }

                        Image {
                            source: root.frame;
                            image-fit: contain;
                            width: parent.width;
                            height: parent.height;
                        }

                        TouchArea {
                            width: parent.width;
                            height: parent.height;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down {
                                    rdp-focus.focus();
                                }
                                root.rdp-pointer-event(
                                    event.kind == PointerEventKind.move ? "move" :
                                    event.kind == PointerEventKind.down ? "down" :
                                    event.kind == PointerEventKind.up ? "up" : "cancel",
                                    event.button == PointerEventButton.left ? "left" :
                                    event.button == PointerEventButton.right ? "right" :
                                    event.button == PointerEventButton.middle ? "middle" : "other",
                                    self.mouse-x, self.mouse-y, parent.width, parent.height);
                            }
                            scroll-event(event) => {
                                root.rdp-scroll-event(
                                    event.delta-x, event.delta-y,
                                    self.mouse-x, self.mouse-y, parent.width, parent.height);
                                accept
                            }
                        }

                        if root.perf-hud-visible: Rectangle {
                            x: parent.width - 382px;
                            y: 12px;
                            width: parent.width < 410px ? parent.width - 24px : 370px;
                            height: 82px;
                            background: #101820dd;
                            border-color: #5eb6e633;
                            border-width: 1px;
                            border-radius: 4px;
                            Text {
                                x: 8px;
                                y: 6px;
                                width: parent.width - 16px;
                                height: parent.height - 12px;
                                text: root.perf-hud-text;
                                color: #e8f4ff;
                                font-size: 10px;
                                wrap: word-wrap;
                                overflow: elide;
                            }
                        }

                        Rectangle {
                            x: 12px;
                            y: parent.height - 34px;
                            width: 190px;
                            height: 22px;
                            background: #00000099;
                            border-radius: 4px;
                            Text {
                                x: 8px;
                                width: parent.width - 16px;
                                height: parent.height;
                                text: root.status;
                                color: #ffffffcc;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }

                if root.state != "connected": Rectangle {
                    width: parent.width < 532px ? parent.width - 52px : 480px;
                    height: root.compact-layout ? parent.height - 64px : 436px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    background: #171717;
                    border-color: #ffffff33;
                    border-width: 1px;
                    border-radius: 12px;

                    Rectangle {
                        width: parent.width;
                        height: parent.height;
                        background: transparent;

                        Rectangle {
                            x: (parent.width - 72px) / 2;
                            y: root.compact-layout ? 28px : 30px;
                            width: 72px;
                            height: 72px;
                            border-radius: 36px;
                            background: root.state == "closing" ? #ffb90026 : #262fa4e7;
                            if root.state == "closing": Text {
                                text: "◌";
                                color: #ffc83d;
                                font-size: 33px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: parent.width;
                                height: parent.height;
                            }
                            if root.state != "closing": Rectangle {
                                x: 20px;
                                y: 21px;
                                width: 32px;
                                height: 23px;
                                background: transparent;
                                border-color: #60b9f4;
                                border-width: 2px;
                                border-radius: 2px;
                            }
                            if root.state != "closing": Rectangle { x: 34px; y: 44px; width: 4px; height: 8px; background: #60b9f4; }
                            if root.state != "closing": Rectangle { x: 27px; y: 51px; width: 18px; height: 2px; background: #60b9f4; }
                        }

                        Rectangle {
                            x: (parent.width - 280px) / 2;
                            y: root.compact-layout ? 118px : 124px;
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: root.state-color;
                        }
                        Text {
                            x: (parent.width - 280px) / 2 + 19px;
                            y: root.compact-layout ? 111px : 117px;
                            width: 261px;
                            height: 28px;
                            text: root.state-title;
                            color: #ffffff;
                            font-size: 21px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }
                        Text {
                            x: 32px;
                            y: root.compact-layout ? 153px : 163px;
                            width: parent.width - 64px;
                            height: root.compact-layout ? 48px : 38px;
                            text: root.state-description;
                            color: #ffffffbf;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }

                        if !root.compact-layout: Rectangle {
                            x: 32px;
                            y: 210px;
                            width: parent.width - 64px;
                            height: 92px;
                            background: #10000000;
                            border-color: #ffffff24;
                            border-width: 1px;
                            border-radius: 7px;
                            Text { x: 12px; y: 12px; width: parent.width - 24px; height: 18px; text: root.rdp-status; color: #ffffffe6; font-size: 13px; }
                            Text { x: 12px; y: 35px; width: parent.width - 24px; height: 18px; text: root.session-status; color: #ffffff99; font-size: 12px; }
                            Text { x: 12px; y: 61px; width: parent.width - 24px; height: 20px; text: root.detail-status; color: #ffffff70; font-size: 11px; wrap: word-wrap; }
                        }

                        if !root.compact-layout && root.state != "closing": Rectangle {
                            x: (parent.width - 248px) / 2;
                            y: 324px;
                            width: 132px;
                            height: 36px;
                            background: #2fa4e7;
                            border-radius: 6px;
                            Text { x: 12px; y: 0px; width: 18px; height: 36px; text: "▷"; color: white; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
                            Text { x: 34px; y: 0px; width: 86px; height: 36px; text: "连接"; color: white; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.state = "connecting"; } }
                        }
                        if !root.compact-layout && root.state != "closing": Rectangle {
                            x: (parent.width - 248px) / 2 + 148px;
                            y: 324px;
                            width: 100px;
                            height: 34px;
                            background: transparent;
                            Text { width: parent.width; height: parent.height; text: "查看帮助文档"; color: #60b9f4; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.notification-visible = true; } }
                        }

                        if !root.compact-layout && root.state != "closing": Text { x: 32px; y: 379px; width: parent.width - 64px; height: 16px; text: "连接成功后，此处会自动切换为远程桌面画面。"; color: #ffffff80; font-size: 11px; horizontal-alignment: center; }
                        if !root.compact-layout && root.state != "closing": Text { x: 32px; y: 397px; width: parent.width - 64px; height: 16px; text: "游戏鼠标模式下，按住 Alt 可临时释放本地鼠标。"; color: #ffffff80; font-size: 11px; horizontal-alignment: center; }
                        if !root.compact-layout && root.state == "closing": Text { x: 32px; y: 379px; width: parent.width - 64px; height: 16px; text: "请稍候，关闭完成后窗口会自动隐藏。"; color: #ffffffcc; font-size: 11px; horizontal-alignment: center; }
                        if !root.compact-layout && root.state == "closing": Text { x: 32px; y: 397px; width: parent.width - 64px; height: 16px; text: "关闭期间已暂停所有 RDP 操作，以避免状态冲突。"; color: #ffffff80; font-size: 11px; horizontal-alignment: center; }
                    }
                }
            }
        }
    }

    callback rdp-pointer-event(kind: string, button: string, x: length, y: length, viewport-width: length, viewport-height: length);
    callback rdp-scroll-event(delta-x: length, delta-y: length, x: length, y: length, viewport-width: length, viewport-height: length);
    callback rdp-key-event(kind: string, key: string, repeat: bool);
    callback rdp-focus-event(kind: string);

    if root.show-control-menu: Rectangle {
        x: root.width - 308px;
        y: 34px;
        width: 300px;
        height: 360px;
        background: #202020;
        border-color: #ffffff40;
        border-width: 1px;
        border-radius: 8px;
        z: 10;

        VerticalBox {
            padding: 8px;
            spacing: 2px;
            Text { text: "连接设置"; color: #ffffff; font-size: 13px; font-weight: 600; vertical-stretch: 0; }
            Rectangle { height: 3px; background: transparent; vertical-stretch: 0; }
            Rectangle { height: 28px; background: transparent; Text { text: "重新连接"; color: #f4f4f4; vertical-alignment: center; width: parent.width; height: parent.height; } TouchArea { clicked => { root.state = "connecting"; root.show-control-menu = false; } } }
            Rectangle { height: 28px; background: transparent; Text { text: root.small-window ? "还原窗口" : "小窗模式"; color: #f4f4f4; vertical-alignment: center; width: parent.width; height: parent.height; } TouchArea { clicked => { root.small-window = !root.small-window; root.show-control-menu = false; } } }
            Rectangle { height: 1px; background: #ffffff35; vertical-stretch: 0; }
            Text { text: "远程桌面分辨率"; color: #ffffff90; font-size: 11px; vertical-stretch: 0; }
            Rectangle { height: 26px; background: transparent; Text { text: "    1920 × 1080"; color: #f4f4f4; vertical-alignment: center; width: parent.width; height: parent.height; } }
            Text { text: "窗口"; color: #ffffff90; font-size: 11px; vertical-stretch: 0; }
            Rectangle { height: 26px; background: transparent; Text { text: "    自适应"; color: #f4f4f4; vertical-alignment: center; width: parent.width; height: parent.height; } }
            Rectangle { height: 26px; background: transparent; Text { text: "    1 : 1"; color: #f4f4f4; vertical-alignment: center; width: parent.width; height: parent.height; } }
            Rectangle { height: 1px; background: #ffffff35; vertical-stretch: 0; }
            Rectangle { height: 26px; background: transparent; Text { text: root.keep-aspect-ratio ? "✓   保持宽高比" : "    保持宽高比"; color: #f4f4f4; vertical-alignment: center; width: parent.width; height: parent.height; } TouchArea { clicked => { root.keep-aspect-ratio = !root.keep-aspect-ratio; } } }
            Text { text: "快捷键"; color: #ffffff90; font-size: 11px; vertical-stretch: 0; }
            Rectangle { height: 26px; background: transparent; Text { text: "    系统组合键发送到远程桌面"; color: #f4f4f4; vertical-alignment: center; width: parent.width; height: parent.height; } }
            Rectangle { height: 1px; background: #ffffff35; vertical-stretch: 0; }
            Rectangle { height: 26px; background: transparent; Text { text: "    发送 Win+D 显示桌面"; color: #f4f4f4; vertical-alignment: center; width: parent.width; height: parent.height; } }
            Rectangle { height: 26px; background: transparent; Text { text: "    发送 Win+Tab 切换窗口"; color: #f4f4f4; vertical-alignment: center; width: parent.width; height: parent.height; } }
            Text { text: "更多"; color: #ffffff90; font-size: 11px; vertical-stretch: 0; }
            Rectangle { height: 28px; background: transparent; Text { text: "    打开连接诊断…"; color: #f4f4f4; vertical-alignment: center; width: parent.width; height: parent.height; } }
        }
    }

    if root.notification-visible: Rectangle {
        x: 8px;
        y: 40px;
        width: root.width - 16px;
        height: 54px;
        background: #252525;
        border-color: #ffffff45;
        border-width: 1px;
        border-radius: 8px;
        z: 20;
        HorizontalBox {
            padding-left: 16px;
            padding-right: 10px;
            spacing: 10px;
            Text { text: "ⓘ"; color: #60b9f4; font-size: 18px; vertical-alignment: center; vertical-stretch: 1; }
            VerticalBox {
                spacing: 2px;
                vertical-stretch: 1;
                Text { text: "RDP 连接界面"; color: #ffffff; font-size: 12px; font-weight: 600; vertical-stretch: 0; }
                Text { text: "FreeRDP 会话画面会直接显示在连接窗口中；凭据只在本次 Windows 登录提示中使用。"; color: #ffffffbf; font-size: 11px; wrap: word-wrap; vertical-stretch: 1; }
            }
            Rectangle { width: 24px; background: transparent; vertical-stretch: 1; Text { text: "×"; color: #d0d0d0; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } TouchArea { clicked => { root.notification-visible = false; } } }
        }
    }
}
