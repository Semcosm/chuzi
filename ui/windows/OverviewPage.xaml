<Page
    x:Class="Chuzi.Native.Windows.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <Border Padding="32,28,32,32" MaxWidth="900">
      <StackPanel Spacing="24">
        <StackPanel Spacing="4">
          <TextBlock Text="Core" FontSize="32" FontWeight="SemiBold" />
        </StackPanel>
        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
          <Grid ColumnSpacing="18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="StatusIcon" Glyph="&#xE930;" FontSize="28" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock x:Name="StatusText" Text="Checking Core..." FontSize="20" FontWeight="SemiBold" />
              <TextBlock x:Name="StatusDetails" Text="" TextWrapping="Wrap" Opacity="0.72" />
            </StackPanel>
            <ProgressRing x:Name="BusyRing" Grid.Column="2" Width="24" Height="24" IsActive="False" />
          </Grid>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button x:Name="InstallButton" Content="Install Core" Click="InstallButton_Click" />
          <Button x:Name="StartButton" Content="Start Core" Click="StartButton_Click" />
          <Button x:Name="StopButton" Content="Stop Core" Click="StopButton_Click" />
          <Button Content="Refresh" Click="RefreshButton_Click" />
        </StackPanel>
        <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True" />
      </StackPanel>
    </Border>
  </ScrollViewer>
</Page>
