<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Chuzi.Native.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxPackage>false</AppxPackage>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="CorePipeSmokeProgram.cs" />
    <!--
      MainWindow.xaml is retained as the Gallery layout reference, but the
      unpackaged self-contained build creates the window tree in C# so WinUI
      does not invoke LoadComponent for this window during startup.
    -->
    <Page Remove="MainWindow.xaml" />
    <None Update="app.manifest">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="CorePayload\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!--
    dotnet publish omits the application PRI for unpackaged WinUI projects.
    WinUI resource initialization then fails at process startup with
    STATUS_STOWED_EXCEPTION (0xC000027B). Copy the generated PRI into the
    unpackaged payload until the SDK supplies it through ResolvedFileToPublish.
  -->
  <Target Name="CopyProjectPriForUnpackagedPublish"
          AfterTargets="Publish"
          Condition="'$(WindowsPackageType)' == 'None' and '$(UseWinUI)' == 'true'">
    <!--
      The SDK's PRI properties are not populated consistently across
      Microsoft.WindowsAppSDK versions. Find the generated project PRI under
      obj instead of relying on ProjectPriFullPath, then copy it beside the
      executable. Without this file an unpackaged WinUI app can fail during
      XAML resource initialization with STATUS_STOWED_EXCEPTION.
    -->
    <ItemGroup>
      <GeneratedProjectPri Include="$(BaseIntermediateOutputPath)**\*.pri"
                           Exclude="$(BaseIntermediateOutputPath)**\Microsoft.UI*.pri;$(BaseIntermediateOutputPath)**\Microsoft.Windows*.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(GeneratedProjectPri)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
