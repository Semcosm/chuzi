<Window
    x:Class="Chuzi.Native.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Padding="20,16,20,12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Overview" Click="OverviewButton_Click" />
        <Button Content="Settings" Click="SettingsButton_Click" />
        <Button Content="Plugins" Click="PluginsButton_Click" />
      </StackPanel>
    </Border>
    <Frame x:Name="ContentFrame" Grid.Row="1" />
  </Grid>
</Window>
