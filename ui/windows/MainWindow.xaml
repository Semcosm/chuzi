<Window
    x:Class="Chuzi.Native.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <NavigationView
        x:Name="Navigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneTitle="Chuzi"
        SelectionChanged="Navigation_SelectionChanged">
      <Frame x:Name="ContentFrame" />
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Overview" Tag="overview" Icon="Home" />
        <NavigationViewItem Content="Plugins" Tag="plugins" Icon="Repair" />
        <NavigationViewItem Content="Accounts" Tag="accounts" Icon="Contact" />
        <NavigationViewItem Content="Tasks" Tag="tasks" Icon="Play" />
        <NavigationViewItem Content="Settings" Tag="settings" Icon="Setting" />
      </NavigationView.MenuItems>
    </NavigationView>
  </Grid>
</Window>
