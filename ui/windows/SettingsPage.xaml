<Page
    x:Class="Chuzi.Native.Windows.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <Border Padding="32,28,32,32" MaxWidth="900">
      <StackPanel Spacing="24">
        <StackPanel Spacing="4">
          <TextBlock Text="Settings" FontSize="32" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Spacing="2">
          <TextBlock Text="Core" FontSize="20" FontWeight="SemiBold" />
          <TextBlock x:Name="CoreStatusText" Text="Core status is being checked." Opacity="0.72" />
          <TextBlock x:Name="CoreInstalledVersionText" Text="Installed version: none" Opacity="0.72" />
          <ComboBox x:Name="CoreChannel" Header="Core update channel" Width="300" SelectedIndex="0" SelectionChanged="CoreChannel_SelectionChanged">
            <ComboBoxItem Content="Test" Tag="test" />
            <ComboBoxItem Content="Stable" Tag="stable" />
          </ComboBox>
          <ComboBox x:Name="CoreVersion" Header="Core version" Width="420" DisplayMemberPath="DisplayName" SelectionChanged="CoreVersion_SelectionChanged" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="CoreActionButton" Content="Install Core" Click="CoreActionButton_Click" />
            <Button x:Name="UninstallCoreButton" Content="Uninstall Core" Click="UninstallCoreButton_Click" />
          </StackPanel>
        </StackPanel>
        <StackPanel Spacing="2">
          <TextBlock Text="Updates" FontSize="20" FontWeight="SemiBold" />
          <ToggleSwitch x:Name="AutoCheckUpdates" Header="Check for updates automatically" />
          <ToggleSwitch x:Name="AutoRepair" Header="Repair missing files automatically" />
          <ComboBox x:Name="UpdateChannel" Header="App update channel" Width="260" SelectedIndex="0">
            <ComboBoxItem Content="Nightly" Tag="nightly" />
            <ComboBoxItem Content="Stable" Tag="stable" />
          </ComboBox>
          <NumberBox x:Name="CheckInterval" Header="Update interval (minutes)" Minimum="0" Maximum="10080" SmallChange="5" Value="60" Width="260" />
        </StackPanel>
        <StackPanel Spacing="2">
          <TextBlock Text="Startup" FontSize="20" FontWeight="SemiBold" />
          <ToggleSwitch x:Name="LaunchOnLogin" Header="Launch Chuzi when I sign in" />
          <ToggleSwitch x:Name="CloseToTray" Header="Keep Chuzi running when the window closes" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button x:Name="SaveButton" Content="Save settings" Click="SaveButton_Click" />
          <ProgressRing x:Name="BusyRing" Width="22" Height="22" IsActive="False" />
        </StackPanel>
        <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True" />
      </StackPanel>
    </Border>
  </ScrollViewer>
</Page>
