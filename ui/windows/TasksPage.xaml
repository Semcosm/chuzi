<Page
    x:Class="Chuzi.Native.Windows.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <Border Padding="32,28,32,32" MaxWidth="900">
      <StackPanel Spacing="22">
        <StackPanel Spacing="6">
          <TextBlock Text="Tasks" FontSize="32" FontWeight="SemiBold" />
          <TextBlock Text="Track a Core request and cancel it when it is still active." Opacity="0.72" TextWrapping="Wrap" />
        </StackPanel>
        <InfoBar x:Name="CoreRequiredBar" IsOpen="False" IsClosable="False" Severity="Informational" />
        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
          <StackPanel Spacing="12">
            <TextBlock Text="Request ID" FontSize="20" FontWeight="SemiBold" />
            <TextBox x:Name="RequestIDBox" PlaceholderText="Enter a request ID" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button x:Name="RefreshButton" Content="Refresh status" Click="RefreshButton_Click" />
              <Button x:Name="CancelButton" Content="Cancel task" Click="CancelButton_Click" />
              <ProgressRing x:Name="BusyRing" Width="22" Height="22" IsActive="False" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
          <StackPanel Spacing="7">
            <TextBlock Text="Task status" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="RequestText" Text="No task loaded." />
            <TextBlock x:Name="TaskAccountText" Text="" Opacity="0.72" />
            <TextBlock x:Name="TaskStateText" Text="" Opacity="0.72" />
            <TextBlock x:Name="AttemptText" Text="" Opacity="0.72" />
            <TextBlock x:Name="FailureText" Text="" TextWrapping="Wrap" Opacity="0.72" />
          </StackPanel>
        </Border>
        <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True" />
      </StackPanel>
    </Border>
  </ScrollViewer>
</Page>
