{
  "$schema": "schema/policy.schema.json",
  "automation": {
    "hooks_path": ".githooks",
    "required_checks": [
      "ugs-validate"
    ]
  },
  "branching": {
    "merge_strategy": "rebase-ff",
    "profile": "continuous",
    "protected_refs": [
      "main"
    ],
    "topic_prefixes": [
      "feat/",
      "fix/",
      "docs/",
      "chore/",
      "test/"
    ]
  },
  "commits": {
    "core_types": [
      "feat",
      "fix",
      "refactor",
      "docs",
      "test",
      "build",
      "ci",
      "chore",
      "perf",
      "revert"
    ],
    "extended_types": [],
    "signing_level": "commits-signed",
    "trailers_required": true
  },
  "conformance_level": "standard",
  "exceptions": {
    "emergency_direct_push": false,
    "post_event_review_required": true
  },
  "extensions": {},
  "format": "ugs-policy/v0.3",
  "migration": {
    "legacy_policy": "REPOSITORY_POLICY.md",
    "legacy_policy_mode": "warn"
  },
  "policy_version": "0.3",
  "quality": {
    "profile": "standard",
    "required_documents": [
      "README.md",
      "RELEASE.md",
      "LICENSE",
      "SECURITY.md",
      "CODE_OF_CONDUCT.md",
      "SUPPORT.md"
    ],
    "test_entrypoints": [
      "scripts/validate_policy_manifest.sh",
      "scripts/validate_quality_profile.sh",
      "scripts/validate_supply_chain_profile.sh",
      "scripts/validate_action_pinning.sh"
    ]
  },
  "releases": {
    "annotated_tags_required": true,
    "notes_path": "releases/",
    "tag_pattern": "v<major>.<minor>.<patch>",
    "trusted_signatures_required": true,
    "versioning": "semver"
  },
  "repository_shape": {
    "generated_files": "none",
    "large_files": "normal",
    "model": "single",
    "submodules": "none"
  },
  "review": {
    "conclusion_storage": "trailers",
    "human_review": {
      "external_contributions": true,
      "maintainer_authored": false
    },
    "maintainer_ack_sensitive_paths": true,
    "model": "change-level",
    "test_evidence_required": true
  },
  "schema_version": 1,
  "supply_chain": {
    "action_pinning": "full_sha",
    "profile": "basic",
    "release_attestations": "declared",
    "reproducible_builds": "declared",
    "sbom": "declared"
  }
}
