{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semcosm.github.io/UGS/schema/cr-attestation/v1",
  "title": "UGS CR reviewer and test attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "schema_version", "type", "repository", "subject",
    "attester", "conclusion", "issued_at", "valid_from",
    "valid_until", "checks", "signature"
  ],
  "properties": {
    "format": {"const": "ugs-cr-attestation/v1"},
    "schema_version": {"const": 1},
    "type": {"enum": ["review", "test"]},
    "repository": {"type": "string", "minLength": 1},
    "subject": {"$ref": "#/$defs/subject"},
    "attester": {"$ref": "#/$defs/attester"},
    "conclusion": {"enum": ["approved", "accepted", "rejected", "passed", "failed"]},
    "issued_at": {"$ref": "#/$defs/dateTime"},
    "valid_from": {"$ref": "#/$defs/dateTime"},
    "valid_until": {"anyOf": [{"$ref": "#/$defs/dateTime"}, {"type": "null"}]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"oneOf": [{"type": "string", "minLength": 1}, {"$ref": "#/$defs/check"}]}
    },
    "signature": {"$ref": "#/$defs/signature"}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "review"}}},
      "then": {"properties": {
        "conclusion": {"enum": ["approved", "accepted", "rejected"]},
        "attester": {"properties": {"role": {"const": "reviewer"}}},
        "signature": {"properties": {"namespace": {"const": "ugs-cr-review"}}}
      }}
    },
    {
      "if": {"properties": {"type": {"const": "test"}}},
      "then": {"properties": {
        "conclusion": {"enum": ["passed", "failed"]},
        "attester": {"properties": {"role": {"const": "tester"}}},
        "signature": {"properties": {"namespace": {"const": "ugs-cr-test"}}}
      }}
    }
  ],
  "$defs": {
    "oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dateTime": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cr_id", "revision", "binding_sha256", "target_ref", "strategy", "result_oid", "scope"],
      "properties": {
        "cr_id": {"type": "string", "pattern": "^CR-[0-9]{4}$"},
        "revision": {"type": "integer", "minimum": 1},
        "binding_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "target_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
        "strategy": {"enum": ["rebase-ff", "merge", "squash"]},
        "result_oid": {"anyOf": [{"$ref": "#/$defs/oid"}, {"type": "null"}]},
        "scope": {"enum": ["source", "integrated-result"]}
      }
    },
    "attester": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal", "role"],
      "properties": {
        "principal": {"type": "string", "pattern": "^[^@[:space:]]+@[^@[:space:]]+$"},
        "role": {"enum": ["reviewer", "tester"]}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed", "failed", "skipped"]},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "namespace", "principal", "value"],
      "properties": {
        "format": {"const": "ssh"},
        "namespace": {"enum": ["ugs-cr-review", "ugs-cr-test"]},
        "principal": {"type": "string", "pattern": "^[^@[:space:]]+@[^@[:space:]]+$"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$"}
      }
    }
  }
}
