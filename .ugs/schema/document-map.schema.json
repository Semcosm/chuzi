{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semcosm.github.io/UGS/schema/document-map/v1",
  "title": "UGS document map v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "format", "schema_version", "document", "heading", "heading_zh", "nodes"],
  "properties": {
    "$schema": {"const": "schema/document-map.schema.json"},
    "format": {"const": "ugs-document-map/v1"},
    "schema_version": {"const": 1},
    "document": {"type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(?:/|$)).+$"},
    "heading": {"type": "string", "minLength": 1},
    "heading_zh": {"type": "string", "minLength": 1},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}}
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "title_zh"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "title_zh": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(?:/|$)).+$"},
        "children": {"type": "array", "items": {"$ref": "#/$defs/node"}}
      },
      "anyOf": [
        {"required": ["path"]},
        {"required": ["children"], "properties": {"children": {"minItems": 1}}}
      ]
    }
  }
}
