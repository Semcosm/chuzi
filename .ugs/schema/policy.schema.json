{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semcosm.github.io/UGS/schema/policy/v0.3",
  "title": "UGS policy manifest v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "format", "schema_version", "policy_version", "conformance_level", "migration", "branching", "commits", "review", "automation", "releases", "exceptions", "extensions"],
  "properties": {
    "$schema": {"const": "schema/policy.schema.json"},
    "format": {"const": "ugs-policy/v0.3"},
    "schema_version": {"const": 1},
    "policy_version": {"const": "0.3"},
    "conformance_level": {"enum": ["baseline", "standard", "high-trust"]},
    "migration": {"$ref": "#/$defs/migration"},
    "branching": {"$ref": "#/$defs/branching"},
    "commits": {"$ref": "#/$defs/commits"},
    "review": {"$ref": "#/$defs/review"},
    "automation": {"$ref": "#/$defs/automation"},
    "releases": {"$ref": "#/$defs/releases"},
    "exceptions": {"$ref": "#/$defs/exceptions"},
    "quality": {"$ref": "#/$defs/quality"},
    "supply_chain": {"$ref": "#/$defs/supply_chain"},
    "repository_shape": {"$ref": "#/$defs/repository_shape"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "migration": {"type": "object", "additionalProperties": false, "required": ["legacy_policy", "legacy_policy_mode"], "properties": {"legacy_policy": {"const": "REPOSITORY_POLICY.md"}, "legacy_policy_mode": {"const": "warn"}}},
    "branching": {"type": "object", "additionalProperties": false, "required": ["profile", "merge_strategy", "protected_refs", "topic_prefixes"], "properties": {"profile": {"enum": ["continuous", "release" ]}, "merge_strategy": {"enum": ["rebase-ff", "merge", "squash"]}, "protected_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "topic_prefixes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "/$"}}}},
    "commits": {"type": "object", "additionalProperties": false, "required": ["signing_level", "core_types", "extended_types", "trailers_required"], "properties": {"signing_level": {"enum": ["unsigned", "commits-signed", "high-trust-commits-signed"]}, "core_types": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z]+$"}, "uniqueItems": true}, "extended_types": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "uniqueItems": true}, "trailers_required": {"type": "boolean"}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["model", "human_review", "test_evidence_required", "maintainer_ack_sensitive_paths", "conclusion_storage"], "properties": {"model": {"enum": ["change-level", "commit-level"]}, "human_review": {"type": "object", "additionalProperties": false, "required": ["maintainer_authored", "external_contributions"], "properties": {"maintainer_authored": {"type": "boolean"}, "external_contributions": {"type": "boolean"}}}, "test_evidence_required": {"type": "boolean"}, "maintainer_ack_sensitive_paths": {"type": "boolean"}, "conclusion_storage": {"enum": ["trailers", "cr-record"]}}},
    "automation": {"type": "object", "additionalProperties": false, "required": ["required_checks", "hooks_path"], "properties": {"required_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "hooks_path": {"const": ".githooks"}}},
    "releases": {"type": "object", "additionalProperties": false, "required": ["versioning", "tag_pattern", "annotated_tags_required", "trusted_signatures_required", "notes_path"], "properties": {"versioning": {"const": "semver"}, "tag_pattern": {"const": "v<major>.<minor>.<patch>"}, "annotated_tags_required": {"type": "boolean"}, "trusted_signatures_required": {"type": "boolean"}, "notes_path": {"const": "releases/"}}},
    "exceptions": {"type": "object", "additionalProperties": false, "required": ["emergency_direct_push", "post_event_review_required"], "properties": {"emergency_direct_push": {"type": "boolean"}, "post_event_review_required": {"type": "boolean"}}},
    "quality": {"type": "object", "additionalProperties": false, "required": ["profile", "required_documents", "test_entrypoints"], "properties": {"profile": {"enum": ["basic", "standard"]}, "required_documents": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "test_entrypoints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "supply_chain": {"type": "object", "additionalProperties": false, "required": ["profile", "action_pinning", "sbom", "reproducible_builds", "release_attestations"], "properties": {"profile": {"enum": ["basic", "standard", "high-trust"]}, "action_pinning": {"enum": ["none", "declared", "full_sha"]}, "sbom": {"enum": ["none", "declared", "release"]}, "reproducible_builds": {"enum": ["none", "declared", "verified"]}, "release_attestations": {"enum": ["none", "declared", "signed"]}, "evidence": {"$ref": "#/$defs/supply_chain_evidence"}}, "allOf": [{"if": {"properties": {"profile": {"const": "basic"}}}, "then": {"properties": {"action_pinning": {"enum": ["declared", "full_sha"]}, "sbom": {"enum": ["declared", "release"]}, "reproducible_builds": {"enum": ["declared", "verified"]}, "release_attestations": {"enum": ["declared", "signed"]}}}}, {"if": {"properties": {"profile": {"const": "standard"}}}, "then": {"properties": {"action_pinning": {"const": "full_sha"}, "sbom": {"const": "release"}, "reproducible_builds": {"enum": ["declared", "verified"]}, "release_attestations": {"const": "signed"}, "evidence": {"$ref": "#/$defs/complete_supply_chain_evidence"}}, "required": ["evidence"]}}, {"if": {"properties": {"profile": {"const": "high-trust"}}}, "then": {"properties": {"action_pinning": {"const": "full_sha"}, "sbom": {"const": "release"}, "reproducible_builds": {"const": "verified"}, "release_attestations": {"const": "signed"}, "evidence": {"$ref": "#/$defs/complete_supply_chain_evidence"}}, "required": ["evidence"]}}]},
    "supply_chain_evidence": {"type": "object", "additionalProperties": false, "properties": {"sbom_paths": {"$ref": "#/$defs/relative_paths"}, "attestation_paths": {"$ref": "#/$defs/relative_paths"}, "build_record_paths": {"$ref": "#/$defs/relative_paths"}}},
    "complete_supply_chain_evidence": {"type": "object", "additionalProperties": false, "required": ["sbom_paths", "attestation_paths", "build_record_paths"], "properties": {"sbom_paths": {"$ref": "#/$defs/non_empty_relative_paths"}, "attestation_paths": {"$ref": "#/$defs/non_empty_relative_paths"}, "build_record_paths": {"$ref": "#/$defs/non_empty_relative_paths"}}},
    "non_empty_relative_paths": {"allOf": [{"$ref": "#/$defs/relative_paths"}, {"minItems": 1}]},
    "relative_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(?:/|$)).+$"}},
    "repository_shape": {"type": "object", "additionalProperties": false, "required": ["model", "submodules", "generated_files", "large_files"], "properties": {"model": {"enum": ["single", "monorepo"]}, "submodules": {"enum": ["none", "allowed", "required"]}, "generated_files": {"enum": ["none", "tracked", "regenerated"]}, "large_files": {"enum": ["normal", "declared", "lfs"]}}},
    "extensions": {"type": "object", "propertyNames": {"pattern": "^x-"}}
  }
}
