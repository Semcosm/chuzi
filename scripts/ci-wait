#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: $0 <commit-sha> [timeout]" >&2
  exit 2
}

[ "$#" -ge 1 ] && [ "$#" -le 2 ] || usage
commit="$1"
timeout_arg="${2:-30m}"
[[ "$commit" =~ ^[0-9a-fA-F]{40}$ ]] || { echo "commit must be a full SHA-1" >&2; exit 2; }
[[ "$timeout_arg" =~ ^[1-9][0-9]*[smhd]$ ]] || { echo "timeout must be a positive duration such as 30m or 45m" >&2; exit 2; }
commit="$(printf '%s' "$commit" | tr '[:upper:]' '[:lower:]')"
repo="${GH_REPOSITORY:-Semcosm/chuzi}"
workflow="${CI_WORKFLOW:-chuzi-build}"
[[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || { echo "GH_REPOSITORY must be owner/repository" >&2; exit 2; }
[[ "$workflow" =~ ^[A-Za-z0-9_.-]+$ ]] || { echo "CI_WORKFLOW must be a workflow name or file" >&2; exit 2; }
command -v gh >/dev/null 2>&1 || { echo "ci-wait requires the gh CLI" >&2; exit 1; }
command -v timeout >/dev/null 2>&1 || { echo "ci-wait requires the timeout command" >&2; exit 1; }

# Discovery and waiting stay inside one bounded child. Its output is captured
# or discarded, so intermediate Actions state never reaches the caller.
set +e
result="$(timeout --foreground --kill-after=5s "$timeout_arg" bash -s -- "$commit" "$repo" "$workflow" 2>/dev/null <<'INNER'
set -u
commit="$1"
repo="$2"
workflow="$3"
run_id=""
while :; do
  run_line="$(gh run list --repo "$repo" --workflow "$workflow" --commit "$commit" --limit 20 --json databaseId,headSha,createdAt \
    --jq 'map(select(.headSha == "'"$commit"'")) | sort_by(.createdAt) | last | select(.databaseId != null) | "\(.databaseId)\t\(.headSha)"' 2>/dev/null)" || exit 70
  if [ -n "$run_line" ]; then
    read -r run_id run_sha <<<"$run_line"
    [ "$run_sha" = "$commit" ] || exit 70
    break
  fi
  sleep 30
done
if gh run watch "$run_id" --repo "$repo" --interval 30 --exit-status >/dev/null 2>&1; then
  printf 'CI SUCCESS: %s\n' "$commit"
  exit 0
fi
final="$(gh run view "$run_id" --repo "$repo" --json status,conclusion,headSha --jq '"\(.status)\t\(.conclusion)\t\(.headSha)"' 2>/dev/null)" || exit 70
read -r final_status final_conclusion final_sha <<<"$final"
if [ "$final_status" = completed ] && [ "$final_sha" = "$commit" ] && [ "$final_conclusion" != success ]; then
  printf 'CI FAILED: %s (run %s)\n' "$commit" "$run_id"
  exit 1
fi
exit 70
INNER
)"
wait_status=$?
set -e
case "$wait_status" in
  0|1) printf '%s\n' "$result"; exit "$wait_status" ;;
  124|137) printf 'CI TIMEOUT: %s (exceeded %s)\n' "$commit" "$timeout_arg"; exit 124 ;;
  *) printf 'CI ERROR: %s (wait helper failed)\n' "$commit" >&2; exit 1 ;;
esac
