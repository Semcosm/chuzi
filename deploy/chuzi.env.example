# Secret-manager rendered environment file. Never commit populated values.
CHUZI_CREDENTIAL_KEY_ID=deployment-key-2026
CHUZI_CREDENTIAL_KEY=<base64-or-hex-encoded-aes-key>
# Set the name below only if config.json enables Matrix.
CHUZI_MATRIX_ACCESS_TOKEN=<matrix-access-token>
# Optional diagnostics are configured in config.json:
# observability.metrics_listen, observability.log_path,
# observability.log_max_bytes, and observability.log_max_files.
